summary:
  A person's Live after a park leaves the order down on the relay road.

history:
  Only tsPlayLive raised it, and a relayed station never goes through it, so
  no door guarded that station through the night.

target:
  package/contents/ui/main.qml

find:
          if (timeshift.shifted && !root._tsPaused && root._previewUrl === "") _orderGiven();

replace:
          if (false) _orderGiven();

expect:
  Killed by tests/test_invariants.py::test_a_person_giving_the_order_dates_it_afresh.
  Line-neutral.

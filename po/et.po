msgstr "%1 — ühendatud, heli veel ei tule"

#: package/contents/ui/FullRepresentation.qml:6656
msgid "%1 — pairing…"
msgstr "%1 — seon…"

#: package/contents/ui/FullRepresentation.qml:6657
msgid "%1 — new, click to pair"
msgstr "%1 — uus, klõpsa sidumiseks"

#: package/contents/ui/FullRepresentation.qml:6667
msgid "Pair a new speaker…"
msgstr "Seo uus kõlar…"

#: package/contents/ui/FullRepresentation.qml:6683
msgid "Searching — put the speaker in pairing mode…"
msgstr "Otsin — pane kõlar sidumisrežiimi…"

#: package/contents/ui/FullRepresentation.qml:6704
msgid "WiFi & network"
msgstr "WiFi ja võrk"

#: package/contents/ui/FullRepresentation.qml:6736
msgid "%1 (speaker group)"
msgstr "%1 (kõlarigrupp)"

#: package/contents/ui/FullRepresentation.qml:6764
msgid "Balance"
msgstr "Tasakaal"

#: package/contents/ui/FullRepresentation.qml:6778
msgid "This device's share of the volume — the balance follows every master move and is remembered for the device."
msgstr "Selle seadme osa helitugevusest — tasakaal järgib iga põhiliuguri liigutust ja jäetakse seadme jaoks meelde."

#: package/contents/ui/FullRepresentation.qml:6800
msgid "Each device buffers on its own, so rooms may play a few seconds apart. For perfectly synced speakers, group them in the Google Home app — the group appears here as a single device."
msgstr "Iga seade puhverdab voogu omaette, mistõttu ruumid võivad mängida mõne sekundi nihkega. Täpselt sünkroonis kõlarite jaoks loo Google Home'i äpis kõlarigrupp — grupp ilmub siia ühe seadmena."

#: package/contents/ui/FullRepresentation.qml:6810
msgid "Stop casting everywhere"
msgstr "Peata esitus kõigis seadmetes"

#: package/contents/ui/FullRepresentation.qml:6828
msgid "Searching for devices…"
msgstr "Otsin seadmeid…"

#: package/contents/ui/FullRepresentation.qml:6837
msgid "No devices found on your network"
msgstr "Võrgust ei leitud ühtegi seadet"

#: package/contents/ui/main.qml:541
msgid "Station list could not be read"
msgstr "Jaamade nimekirja ei õnnestunud lugeda"

#: package/contents/ui/main.qml:542
msgid "The saved station configuration is malformed. Your data was not changed; fix the servers entry or use Settings → Import."
msgstr "Salvestatud jaamade seadistus on vigane. Sinu andmeid ei muudetud; paranda servers-kirje või kasuta Seaded → Import."

#: package/contents/ui/main.qml:958
msgid "The station did not answer — it may be offline or not available in your country. Try another result."
msgstr "Jaam ei vastanud — ta võib olla maas või sinu riigis kättesaamatu. Proovi mõnda teist tulemust."

#: package/contents/ui/main.qml:1031
msgid "Download gave no answer"
msgstr "Allalaadimine ei andnud vastust"

#: package/contents/ui/main.qml:1032
msgid "Nothing came back from the downloader — try again."
msgstr "Allalaadijalt ei tulnud midagi tagasi — proovi uuesti."

#: package/contents/ui/main.qml:2864
msgid "%1 devices"
msgstr "%1 seadet"

#: package/contents/ui/main.qml:3772
msgid "The Bluetooth speaker"
msgstr "Bluetooth-kõlar"

#: package/contents/ui/main.qml:3771
msgid "%1 is connected, but its sound never arrived"
msgstr "%1 on ühendatud, aga heli ei jõudnud kohale"

#: package/contents/ui/main.qml:3773
msgid "Turn the speaker off and on again, then reconnect it."
msgstr "Lülita kõlar korraks välja ja uuesti sisse, siis ühenda uuesti."

#: package/contents/ui/main.qml:4260
msgid "Station seems to be off the air"
msgstr "Jaam paistab olevat eetrist väljas"

#: package/contents/ui/main.qml:4262
msgid "%1 is not answering at any address the directory knows. It stays in your list."
msgstr "%1 ei vasta ühelgi aadressil, mida kataloog teab. Jaam jääb sinu nimekirja."

#: package/contents/ui/main.qml:4264
msgid "%1 is not answering at any address the directory knows. It stays in your list — trying again for a few minutes, then leaving it be."
msgstr ""
"%1 ei vasta ühelgi aadressil, mida kataloog teab. Jaam jääb sinu nimekirja — "
"proovin veel mõne minuti ja jätan siis rahule."

#: package/contents/ui/main.qml:4265
msgid "%1 is not answering at any address the directory knows. It stays in your list — trying again in the background."
msgstr "%1 ei vasta ühelgi kataloogile teadaoleval aadressil. Jaam jääb sinu nimekirja — proovin taustal uuesti."

#: package/contents/ui/main.qml:4360
msgid "Playing from a backup address"
msgstr "Mängib varuaadressilt"

#: package/contents/ui/main.qml:4361
msgid "The station's saved address is not answering — playing the directory's closest match for now. Your saved address was kept."
msgstr "Jaama salvestatud aadress ei vasta — praegu mängib kataloogi lähim vaste. Sinu salvestatud aadress jäi alles."

#: package/contents/ui/main.qml:4401
msgid "Station found at a new address"
msgstr "Jaam leitud uuelt aadressilt"

#: package/contents/ui/main.qml:4402
msgid "%1 moved — the new address was saved to your list."
msgstr "%1 kolis — uus aadress salvestati sinu nimekirja."


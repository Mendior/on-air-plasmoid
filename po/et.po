msgstr "Ei õnnestunud ühenduda: %1"

#: package/contents/ui/main.qml:5764
msgid "Make sure the speaker is switched on and in range."
msgstr "Veendu, et kõlar on sisse lülitatud ja levialas."

#: package/contents/ui/main.qml:5880
msgid "Could not pair with %1"
msgstr "Sidumine ebaõnnestus: %1"

#: package/contents/ui/main.qml:5882
msgid "Put the speaker in pairing mode (hold its Bluetooth button) and try again."
msgstr "Pane kõlar sidumisrežiimi (hoia selle Bluetooth-nuppu all) ja proovi uuesti."

#: package/contents/ui/main.qml:5980 package/contents/ui/main.qml:6049
msgid "yt-dlp is not installed"
msgstr "yt-dlp pole paigaldatud"

#: package/contents/ui/main.qml:5981 package/contents/ui/main.qml:6050
msgid "Install yt-dlp (and ffmpeg) to download tracks."
msgstr "Lugude allalaadimiseks paigalda yt-dlp (ja ffmpeg)."

#: package/contents/ui/main.qml:6000 package/contents/ui/main.qml:6069
msgid "Nothing found to download"

msgstr "Otsin — pane kõlar sidumisrežiimi…"

#: package/contents/ui/FullRepresentation.qml:6195
msgid "WiFi & network"
msgstr "WiFi ja võrk"

#: package/contents/ui/FullRepresentation.qml:6227

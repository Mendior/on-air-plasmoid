msgstr "Szukam — przełącz głośnik w tryb parowania…"

#: package/contents/ui/FullRepresentation.qml:6732
msgid "WiFi & network"
msgstr "WiFi i sieć"

#: package/contents/ui/FullRepresentation.qml:6764
msgid "%1 (speaker group)"
msgstr "%1 (grupa głośników)"

#: package/contents/ui/FullRepresentation.qml:6792
msgid "Balance"
msgstr "Balans"

#: package/contents/ui/FullRepresentation.qml:6806
msgid "This device's share of the volume — the balance follows every master move and is remembered for the device."
msgstr "Udział tego urządzenia w głośności — balans podąża za każdym ruchem suwaka głównego i jest zapamiętywany dla urządzenia."

#: package/contents/ui/FullRepresentation.qml:6828
msgid "Each device buffers on its own, so rooms may play a few seconds apart. For perfectly synced speakers, group them in the Google Home app — the group appears here as a single device."
msgstr "Każde urządzenie buforuje strumień osobno, więc pomieszczenia mogą grać z kilkusekundowym przesunięciem. Aby głośniki grały idealnie równo, zgrupuj je w aplikacji Google Home — grupa pojawi się tutaj jako jedno urządzenie."

#: package/contents/ui/FullRepresentation.qml:6838
msgid "Stop casting everywhere"
msgstr "Zatrzymaj odtwarzanie na wszystkich urządzeniach"

#: package/contents/ui/FullRepresentation.qml:6856
msgid "Searching for devices…"
msgstr "Wyszukiwanie urządzeń…"

#: package/contents/ui/FullRepresentation.qml:6865
msgid "No devices found on your network"

msgstr "Czyszczenie tytułów:"

#: package/contents/ui/config/configAppearance.qml:192
msgid "Use Claude CLI to clean up messy titles before download (optional)"
msgstr "Użyj Claude CLI do czyszczenia niechlujnych tytułów przed pobraniem (opcjonalnie)"

#: package/contents/ui/config/configAppearance.qml:200
msgid "Behavior"
msgstr "Zachowanie"

#: package/contents/ui/config/configAppearance.qml:205
msgid "Marquee speed:"

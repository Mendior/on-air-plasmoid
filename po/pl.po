msgstr "Szukaj okładek w internecie (Deezer, iTunes)"

#: package/contents/ui/config/configAppearance.qml:117
msgid "Backdrop:"
msgstr "Tło:"

#: package/contents/ui/config/configAppearance.qml:118
msgid "Blurred album art behind now playing"
msgstr "Rozmyta okładka w tle widoku odtwarzania"

#: package/contents/ui/config/configAppearance.qml:124
msgid "Accent color:"
msgstr "Kolor akcentu:"

#: package/contents/ui/config/configAppearance.qml:125
msgid "Follow the system accent color instead of the built-in emerald"
msgstr "Używaj koloru akcentu systemu zamiast wbudowanej szmaragdowej zieleni"

#: package/contents/ui/config/configAppearance.qml:130
msgid "On battery:"
msgstr "Na baterii:"

#: package/contents/ui/config/configAppearance.qml:131
msgid "Hold the animations still and check less often"
msgstr "Zatrzymaj animacje i sprawdzaj rzadziej"

#: package/contents/ui/config/configAppearance.qml:137
msgid "Unplugged, the record stops spinning and the equalizer bars hold still; background checks slow down. Sound and every control work exactly as before. The system's power-saver profile counts too."
msgstr "Po odłączeniu od zasilania płyta przestaje się kręcić, a słupki korektora zastygają; sprawdzanie w tle zwalnia. Dźwięk i wszystkie elementy sterowania działają dokładnie jak wcześniej. Liczy się także systemowy profil oszczędzania energii."

#: package/contents/ui/config/configAppearance.qml:148
msgid "Integration"
msgstr "Integracja"

#: package/contents/ui/config/configAppearance.qml:154
msgid "System integration:"
msgstr "Integracja z systemem:"

#: package/contents/ui/config/configAppearance.qml:155
msgid "Allow control via media keys (MPRIS)"
msgstr "Zezwól na sterowanie klawiszami multimedialnymi (MPRIS)"


#~ msgstr "Automatyczne sprawdzenie: ustawiono na %1 ms — jeden głośnik na moment ucichł przy zmianie opóźnienia"

#~ msgid "Auto-check: set to %1 ms quietly, no music interrupted"
#~ msgstr "Automatyczne sprawdzenie: ustawiono po cichu na %1 ms, bez przerywania muzyki"

#~ msgid "Auto-check: adjusted quietly, no music interrupted"
#~ msgstr "Automatyczne sprawdzenie: wyregulowano po cichu, bez przerywania muzyki"


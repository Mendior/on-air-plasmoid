msgstr "%1 — parowanie…"

#: package/contents/ui/FullRepresentation.qml:6683
msgid "%1 — new, click to pair"
msgstr "%1 — nowy, kliknij aby sparować"

#: package/contents/ui/FullRepresentation.qml:6693

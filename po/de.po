msgstr "Suche läuft — versetze den Lautsprecher in den Kopplungsmodus…"

#: package/contents/ui/FullRepresentation.qml:6678
msgid "WiFi & network"
msgstr "WLAN & Netzwerk"

#: package/contents/ui/FullRepresentation.qml:6709
msgid "%1 (speaker group)"

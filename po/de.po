msgstr "Verbindung mit %1 nicht möglich"

#: package/contents/ui/main.qml:5764
msgid "Make sure the speaker is switched on and in range."
msgstr "Stellen Sie sicher, dass der Lautsprecher eingeschaltet und in Reichweite ist."

#: package/contents/ui/main.qml:5880
msgid "Could not pair with %1"
msgstr "Kopplung mit %1 fehlgeschlagen"

#: package/contents/ui/main.qml:5882
msgid "Put the speaker in pairing mode (hold its Bluetooth button) and try again."
msgstr "Versetze den Lautsprecher in den Kopplungsmodus (Bluetooth-Taste gedrückt halten) und versuche es erneut."

#: package/contents/ui/main.qml:5980 package/contents/ui/main.qml:6049
msgid "yt-dlp is not installed"
msgstr "yt-dlp ist nicht installiert"

#: package/contents/ui/main.qml:5981 package/contents/ui/main.qml:6050
msgid "Install yt-dlp (and ffmpeg) to download tracks."
msgstr "Installieren Sie yt-dlp (und ffmpeg), um Titel herunterzuladen."

#: package/contents/ui/main.qml:6000 package/contents/ui/main.qml:6069
msgid "Nothing found to download"
msgstr "Nichts zum Herunterladen gefunden"

#: package/contents/ui/main.qml:6001 package/contents/ui/main.qml:6070
msgid "No track matched \"%1\" — a show or album title often has no single track to find."
msgstr "Kein Titel passte zu \"%1\" — hinter einem Sendungs- oder Albumnamen steht oft kein einzelner Titel."

#: package/contents/ui/main.qml:6013
msgid "Found only a different show — skipped"
msgstr "Nur eine andere Sendung gefunden — übersprungen"

#: package/contents/ui/main.qml:6014
msgid "Best match for \"%1\" was \"%2\". Not downloading the wrong one."
msgstr "Bester Treffer für \"%1\" war \"%2\". Die falsche wird nicht heruntergeladen."

#: package/contents/ui/main.qml:6036
msgid "Downloading again without the cover"
msgstr "Erneuter Download ohne Cover"

#: package/contents/ui/main.qml:6037
msgid "Embedding tags needs the python-mutagen package — install it to get covers in your files."
msgstr "Zum Einbetten der Metadaten wird das Paket python-mutagen benötigt — installieren Sie es, um Cover in den Dateien zu erhalten."

#: package/contents/ui/main.qml:6065
msgid "Track downloaded ✓"
msgstr "Titel heruntergeladen ✓"

#: package/contents/ui/main.qml:6066

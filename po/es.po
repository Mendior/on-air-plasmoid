#: package/contents/ui/config/configAppearance.qml:117
msgid "Backdrop:"
msgstr "Fondo:"

#: package/contents/ui/config/configAppearance.qml:118
msgid "Blurred album art behind now playing"
msgstr "Carátula difuminada detrás de la vista de reproducción"

#: package/contents/ui/config/configAppearance.qml:124
msgid "Accent color:"
msgstr "Color de acento:"

#: package/contents/ui/config/configAppearance.qml:125
msgid "Follow the system accent color instead of the built-in emerald"
msgstr "Seguir el color de acento del sistema en lugar del esmeralda integrado"

#: package/contents/ui/config/configAppearance.qml:130
msgid "On battery:"
msgstr "Con batería:"

#: package/contents/ui/config/configAppearance.qml:131
msgid "Hold the animations still and check less often"
msgstr "Detener las animaciones y comprobar con menos frecuencia"

#: package/contents/ui/config/configAppearance.qml:137
msgid "Unplugged, the record stops spinning and the equalizer bars hold still; background checks slow down. Sound and every control work exactly as before. The system's power-saver profile counts too."
msgstr "Sin enchufe, el disco deja de girar y las barras del ecualizador se detienen; las comprobaciones en segundo plano se espacian. El sonido y todos los controles funcionan igual que antes. El perfil de ahorro de energía del sistema también cuenta."


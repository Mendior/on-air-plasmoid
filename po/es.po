#: package/contents/ui/FullRepresentation.qml:6590
msgid "Tap again to forget — pairing again is the only way back"
msgstr "Toca de nuevo para olvidar: la única vuelta es emparejar otra vez"

#: package/contents/ui/FullRepresentation.qml:6591

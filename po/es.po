#: package/contents/ui/config/configGeneral.qml:1306
msgid "Fetch fresh logos for all stations; existing logos are kept if nothing better is found"
msgstr "Obtener logotipos nuevos para todas las emisoras; los actuales se conservan si no se encuentra nada mejor"

#: package/contents/ui/config/configGeneral.qml:1321
msgid "Import…"
msgstr "Importar…"

#: package/contents/ui/config/configGeneral.qml:1327

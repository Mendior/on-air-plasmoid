#: package/contents/ui/config/configAppearance.qml:300
msgid "Looks the station up on radio-browser.info and picks the best-quality stream URL"
msgstr "Busca la emisora en radio-browser.info y elige la URL de emisión de mejor calidad"

#: package/contents/ui/config/configAppearance.qml:305
msgid "Find a station's new address when its stream dies"
msgstr "Buscar la nueva dirección de una emisora cuando su flujo muere"

#: package/contents/ui/config/configAppearance.qml:308
msgid "Stations move servers; when playback fails, the station is looked up on radio-browser.info and the address it is reachable at now is saved to your list"
msgstr "Las emisoras cambian de servidor; si la reproducción falla, la emisora se busca en radio-browser.info y la dirección que funciona ahora se guarda en tu lista"

#: package/contents/ui/config/configAppearance.qml:313
msgid "Count my listening in the worldwide station catalog"
msgstr "Contar mi escucha en el catálogo mundial de emisoras"

#: package/contents/ui/config/configAppearance.qml:316
msgid "When a station starts playing, a click is reported to radio-browser.info — the request carries the station id only, no account or personal data is added; popular stations become easier to find for everyone"
msgstr "Cuando una emisora empieza a sonar, se notifica un clic a radio-browser.info; la petición solo lleva el identificador de la emisora, sin cuenta ni datos personales; las emisoras populares resultan más fáciles de encontrar para todos"


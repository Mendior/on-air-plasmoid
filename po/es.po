msgstr "La descarga no respondió"

#: package/contents/ui/main.qml:1034
msgid "Nothing came back from the downloader — try again."
msgstr "No llegó nada del descargador — inténtalo de nuevo."

#: package/contents/ui/main.qml:2928
msgid "%1 devices"
msgstr "%1 dispositivos"

#: package/contents/ui/main.qml:3815
msgid "The Bluetooth speaker"
msgstr "El altavoz Bluetooth"

#: package/contents/ui/main.qml:3814
msgid "%1 is connected, but its sound never arrived"
msgstr "%1 está conectado, pero su sonido nunca llegó"

#: package/contents/ui/main.qml:3816
msgid "Turn the speaker off and on again, then reconnect it."
msgstr "Apaga y enciende el altavoz y vuelve a conectarlo."

#: package/contents/ui/main.qml:4353
msgid "%1 is not answering, and the directory could not be asked whether it has moved. It stays in your list."
msgstr "%1 no responde, y no se pudo preguntar al directorio si se ha mudado. Se mantiene en tu lista."

#: package/contents/ui/main.qml:4370
msgid "Station seems to be off the air"
msgstr "La emisora parece estar fuera del aire"

#: package/contents/ui/main.qml:4372
msgid "%1 is not answering at any address the directory knows. It stays in your list."
msgstr "%1 no responde en ninguna dirección conocida por el directorio. Se mantiene en tu lista."

#: package/contents/ui/main.qml:4374
msgid "%1 is not answering at any address the directory knows. It stays in your list — trying again for a few minutes, then leaving it be."
msgstr "%1 no responde en ninguna dirección conocida por el directorio. Se mantiene en tu lista — se seguirá intentando unos minutos y luego se dejará."

#: package/contents/ui/main.qml:4375
msgid "%1 is not answering at any address the directory knows. It stays in your list — trying again in the background."
msgstr "%1 no responde en ninguna dirección conocida por el directorio. Se mantiene en tu lista — se seguirá intentando en segundo plano."

#: package/contents/ui/main.qml:4566
msgid "Playing from a backup address"
msgstr "Reproduciendo desde una dirección de respaldo"

#: package/contents/ui/main.qml:4568
msgid "The station's saved address is not answering — playing the directory's closest match for now. Your saved address was kept."
msgstr "La dirección guardada de la emisora no responde; por ahora suena la coincidencia más cercana del directorio. Tu dirección guardada se conservó."

#: package/contents/ui/main.qml:4569

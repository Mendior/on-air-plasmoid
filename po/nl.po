#: package/contents/ui/config/configAppearance.qml:132
msgid "Looks the station up on radio-browser.info and picks the best-quality stream URL"
msgstr "Zoekt het station op via radio-browser.info en kiest de stream-URL met de beste kwaliteit"

#: package/contents/ui/config/configAppearance.qml:137
msgid "Find a station's new address when its stream dies"
msgstr "Zoek het nieuwe adres van een zender wanneer de stream sterft"

#: package/contents/ui/config/configAppearance.qml:140
msgid "Stations move servers; when playback fails, the station is looked up on radio-browser.info and the address it is reachable at now is saved to your list"
msgstr "Zenders wisselen van server; als het afspelen mislukt, wordt de zender opgezocht op radio-browser.info en wordt het nu werkende adres in je lijst opgeslagen"

#: package/contents/ui/config/configAppearance.qml:145
msgid "Count my listening in the worldwide station catalog"
msgstr "Mijn luisteren meetellen in de wereldwijde zendercatalogus"

#: package/contents/ui/config/configAppearance.qml:148
msgid "When a station starts playing, a click is reported to radio-browser.info — the request carries the station id only, no account or personal data is added; popular stations become easier to find for everyone"
msgstr "Wanneer een zender begint te spelen, wordt een klik gemeld aan radio-browser.info — het verzoek bevat alleen het zender-ID, geen account of persoonlijke gegevens; populaire zenders worden zo voor iedereen makkelijker te vinden"


#: package/contents/ui/SyncEngine.qml:1686
msgid "Auto-check %1: settling after the adjustment"
msgstr "Automatische controle %1: stabiliseert na de aanpassing"

#: package/contents/ui/SyncEngine.qml:1617
msgid "Auto-check %1: reading would not settle — the microphone may be too far from the speakers"
msgstr "Autocontrole %1: meting werd niet stabiel — de microfoon staat mogelijk te ver van de speakers"

#: package/contents/ui/SyncEngine.qml:1623
msgid "Auto-check %1: too quiet to tell"
msgstr "Autocontrole %1: te stil om te zeggen"

#: package/contents/ui/SyncEngine.qml:1738
msgid "Auto-check %1: in sync — measured %2 ms"
msgstr "Automatische controle %1: synchroon — gemeten %2 ms"

#: package/contents/ui/SyncEngine.qml:1739
msgid "Auto-check %1: in sync"
msgstr "Autocontrole %1: synchroon"

#: package/contents/ui/SyncEngine.qml:1749
msgid "Auto-check %1: %2 ms apart — measured %3 ms"
msgstr "Automatische controle %1: %2 ms uit elkaar — gemeten %3 ms"

#: package/contents/ui/SyncEngine.qml:1750
msgid "Auto-check %1: still %2 ms apart (0 = in step)"
msgstr "Autocontrole %1: nog %2 ms uit elkaar (0 = gelijk)"

#: package/contents/ui/SyncEngine.qml:1787
msgid "Sync has drifted"
msgstr "Synchronisatie is verlopen"

#: package/contents/ui/SyncEngine.qml:1788
msgid "The speakers are audibly apart again — run Calibrate when convenient."
msgstr "De luidsprekers lopen weer hoorbaar uiteen — voer de kalibratie uit wanneer het uitkomt."

#: package/contents/ui/SyncEngine.qml:1897
msgid "Speaker timing drifted"
msgstr "Luidsprekertiming is verlopen"

#: package/contents/ui/SyncEngine.qml:1898
msgid "A Bluetooth speaker came back noticeably off its calibration — the sync compensated automatically. Recalibrate when convenient for exact ears."
msgstr "Een Bluetooth-luidspreker kwam merkbaar naast zijn kalibratie terug — de synchronisatie heeft automatisch gecompenseerd. Kalibreer opnieuw wanneer het uitkomt voor exacte oren."

#: package/contents/ui/SyncEngine.qml:2614
#: package/contents/ui/SyncEngine.qml:2868
msgid "Auto-check: listening…"
msgstr "Automatische controle: luisteren…"

#: package/contents/ui/SyncEngine.qml:2839
msgid "Auto-check %1: fewer than two speakers can reproduce the test tone — nothing to compare"
msgstr "Autocontrole %1: minder dan twee speakers kunnen de testtoon weergeven — niets te vergelijken"

#: package/contents/ui/SyncEngine.qml:2898
msgid "Auto-check %1: no answer came back"
msgstr "Autocontrole %1: geen antwoord terug"

#: package/contents/ui/SyncEngine.qml:2946
msgid "%1: %2 ms"
msgstr "%1: %2 ms"

#. i18n() is given at runtime and the translation is

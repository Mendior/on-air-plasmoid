msgstr "Alle lokale uitgangen (On Air)"

#: package/contents/ui/SyncEngine.qml:4573
msgid "Auto-check: measured %1 ms — takes effect the next time the music pauses"
msgstr "Automatische controle: %1 ms gemeten — wordt actief zodra de muziek pauzeert"

#: package/contents/ui/SyncEngine.qml:4574
msgid "Auto-check: adjusted — takes effect the next time the music pauses"
msgstr "Automatische controle: bijgesteld — wordt actief zodra de muziek pauzeert"

#: package/contents/ui/SyncEngine.qml:4763

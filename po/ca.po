msgstr "L'adaptador no s'engega. Comproveu l'interruptor de Bluetooth de la safata del sistema o des de les preferències del sistema."

#: package/contents/ui/main.qml:7992 package/contents/ui/main.qml:8110
msgid "the Bluetooth device"
msgstr "el dispositiu Bluetooth"

#: package/contents/ui/main.qml:7991
msgid "Could not connect to %1"
msgstr "No s'ha pogut connectar amb %1."

#: package/contents/ui/main.qml:7993
msgid "Make sure the speaker is switched on and in range."
msgstr "Assegureu-vos que l'altaveu està engegat i dins de l'abast."

#: package/contents/ui/main.qml:8109
msgid "Could not pair with %1"
msgstr "No s'ha pogut emparellar amb %1."

#: package/contents/ui/main.qml:8111
msgid "Put the speaker in pairing mode (hold its Bluetooth button) and try again."
msgstr "Poseu l'altaveu en mode d'aparellament (mantingueu premut el seu botó Bluetooth) i intenteu-ho de nou."

#: package/contents/ui/main.qml:8219
msgid "ffmpeg is not installed"
msgstr "L'ffmpeg no s'ha instal·lat."

#: package/contents/ui/main.qml:8220
msgid "Install ffmpeg to record radio."
msgstr "Instal·leu l'ffmpeg per a gravar emissions de ràdio."

#: package/contents/ui/main.qml:8225
msgid "curl is not installed"
msgstr "El curl no està instal·lat."

#: package/contents/ui/main.qml:8226
msgid "Install curl to record radio."
msgstr "Instal·leu el curl per a gravar la ràdio."

#: package/contents/ui/main.qml:8229
msgid "Not enough disk space for this recording"
msgstr "No hi ha prou espai al disc per a la gravació."

#: package/contents/ui/main.qml:8230
msgid "Free some space in %1 and try again."
msgstr "Allibereu espai de %1 i torneu-ho a intentar."

#: package/contents/ui/main.qml:8233
msgid "Recording saved ✓ (%1)"
msgstr "Gravació desada ✓ (%1)"

#: package/contents/ui/main.qml:8237
msgid "Recording interrupted (%1 captured)"
msgstr "Gravació interrompuda (gravat: %1)"

#: package/contents/ui/main.qml:8239
msgid "%1 — the file is much smaller than expected."
msgstr "%1 — El fitxer és molt més petit del que s'esperava."

#: package/contents/ui/main.qml:8244
msgid "The stream could not be captured."
msgstr "L'emissió no s'ha pogut gravar."

#: package/contents/ui/main.qml:8327 package/contents/ui/main.qml:8396
msgid "yt-dlp is not installed"
msgstr "L'yt-dlp no està instal·lat."

#: package/contents/ui/main.qml:8328 package/contents/ui/main.qml:8397
msgid "Install yt-dlp (and ffmpeg) to download tracks."
msgstr "Instal·leu l'yt-dlp (i l'ffmpeg) per a descarregar peces."

#: package/contents/ui/main.qml:8347 package/contents/ui/main.qml:8416
msgid "Nothing found to download"
msgstr "No s'ha trobat res per a descarregar."

#: package/contents/ui/main.qml:8348 package/contents/ui/main.qml:8417
msgid "No track matched \"%1\" — a show or album title often has no single track to find."
msgstr "Cap peça ha coincidit amb «%1». Normalment, un programa o el títol d'un àlbum no tenen només un tema o episodi."

#: package/contents/ui/main.qml:8360
msgid "Found only a different show — skipped"
msgstr "Només s'ha trobat un programa diferent. S'omet."

#: package/contents/ui/main.qml:8361
msgid "Best match for \"%1\" was \"%2\". Not downloading the wrong one."
msgstr "La millor coincidència per a «%1» ha estat «%2». L'equivocada no es descarrega."

#: package/contents/ui/main.qml:8383
msgid "Downloading again without the cover"
msgstr "Es torna a descarregar sense la caràtula"

#: package/contents/ui/main.qml:8384
msgid "Embedding tags needs the python-mutagen package — install it to get covers in your files."
msgstr "Per a incrustar etiquetes fa falta el paquet python-mutagen. Instal·leu-lo per a afegir les caràtules als vostres fitxers."

#: package/contents/ui/main.qml:8412
msgid "Track downloaded ✓"
msgstr "Peça descarregada ✓"

#: package/contents/ui/main.qml:8413
msgid "Saved as \"%1\" — newest first in My Music"
msgstr "Desat com a «%1». El més nou, primer, a «La meva música»."

#: package/contents/ui/main.qml:8421
msgid "Download failed"
msgstr "La descàrrega ha fallat."

#: package/contents/ui/main.qml:8422
msgid "Unknown error"
msgstr "Error desconegut"

#: package/contents/ui/main.qml:8896
msgid "Audio output changed"
msgstr "La sortida de so ha canviat."

#: package/contents/ui/main.qml:8897
msgid "The chosen output device disappeared — using the system default instead."
msgstr "El dispositiu de sortida triat ha desaparegut. Es fa servir el dispositiu per defecte del sistema."

#: package/contents/ui/MediaListItem.qml:457
msgid "Click again to confirm removal"
msgstr "Feu-hi clic una altra vegada per a confirmar l'esborrat."

#: package/contents/ui/MediaListItem.qml:458
msgid "Remove station from list"
msgstr "Trau l'emissora de la llista"

#: package/contents/ui/MediaListItem.qml:532
msgid "Waiting for track info…"
msgstr "S'espera la informació de la peça…"

#: package/contents/ui/SyncEngine.qml:370
msgid "Could not combine the outputs"
msgstr "Les sortides no s'han pogut combinar."

#: package/contents/ui/SyncEngine.qml:371
msgid "pactl refused to create the combined output."
msgstr "El pactl ha refusat crear la sortida combinada."

#: package/contents/ui/SyncEngine.qml:793
msgid "The Bluetooth speaker trails by %1 ms, and every speaker's loudness was matched at the microphone — all set and remembered."
msgstr "L'altaveu Bluetooth va %1 ms endarrerit i s'ha igualat el volum de tots els altaveus respecte el micròfon. S'ha ajustat i s'han desat els canvis."

#: package/contents/ui/SyncEngine.qml:794
msgid "The Bluetooth speaker trails by %1 ms — the delay is set and remembered for this device."
msgstr "L'altaveu Bluetooth va %1 ms endarrerit. S'ha establert l'endarreriment d'aquest dispositiu i s'ha desat."

#: package/contents/ui/SyncEngine.qml:796
msgid "Balance levels set earlier were replaced by the measured ones."
msgstr "Els nivells de balanç ajustats anteriorment s'han reemplaçat pels mesurats."

#: package/contents/ui/SyncEngine.qml:802
msgid "The speakers were matched to the quietest one and the group's volume was raised by %1% to make up for it."
msgstr "Els altaveus s'han igualat amb el més fluix i el volum del grup s'ha augmentat un %1 % per a compensar-ho."

#: package/contents/ui/SyncEngine.qml:803
msgid "The speakers were matched to the quietest one, so the room is quieter than before — turn the volume up if you want it back."
msgstr "Els altaveus s'han igualat al que reprodueix més fluix i l'entorn ara estarà més tranquil que abans. Apugeu el volum si voleu recuperar la intensitat anterior."

#: package/contents/ui/SyncEngine.qml:812
msgid "The microphone clipped on %1 — that balance was left unchanged; lower the speaker's volume and calibrate again."
msgstr "El micròfon s'ha saturat amb %1. Aquest balanç no s'ha modificat. Baixeu el volum de l'altaveu i calibreu de nou."

#: package/contents/ui/SyncEngine.qml:825
msgid "Measured with %1 — the default microphone stayed silent."
msgstr "Mesurat amb %1, el micròfon predeterminat s'ha mantingut en silenci."

#: package/contents/ui/SyncEngine.qml:826
msgid "Speakers calibrated"
msgstr "Altaveus calibrats"

#: package/contents/ui/SyncEngine.qml:839
#: package/contents/ui/SyncEngine.qml:847
#: package/contents/ui/SyncEngine.qml:908
#: package/contents/ui/SyncEngine.qml:916
#: package/contents/ui/SyncEngine.qml:920
msgid "Calibration did not succeed"
msgstr "La calibració ha fallat."

#: package/contents/ui/SyncEngine.qml:840
msgid "The inaudible tone did not reach the microphone from these speakers. Move the microphone closer, or turn off \"Measure with a tone too high to hear\" to measure with the audible clicks."
msgstr "El to inaudible no ha arribat al micròfon des dels altaveus. Moveu el micròfon més a prop o desactiveu «Mesura amb un to massa agut per a sentir-lo» per a fer servir clics audibles."

#: package/contents/ui/SyncEngine.qml:848
#: package/contents/ui/SyncEngine.qml:1221
msgid "Every microphone delivered pure silence. A mic's own mute button is invisible to the system — check the light on the microphone itself, or set a working microphone as the default."
msgstr "Cada micròfon ha detectat silenci absolut. El botó de silenci del propi micròfon és invisible per al sistema. Comproveu el llum del micròfon o establiu com a predeterminat un micròfon que funcioni."

#: package/contents/ui/SyncEngine.qml:880
msgid "Calibration"
msgstr "Calibració"

#: package/contents/ui/SyncEngine.qml:882
msgid "The inaudible reading would not settle at this level — trying once more, louder."
msgstr "La lectura inaudible no s'ha estabilitzat en aquest nivell; es torna a provar una vegada més, més fort."

#: package/contents/ui/SyncEngine.qml:883
msgid "The clicks were too quiet for this room — trying once more, louder."
msgstr "Els clics eren massa dèbils per a aquesta habitació. Es tornarà a provar amb clics més forts."

#: package/contents/ui/SyncEngine.qml:909
msgid "The two speakers timed impossibly far apart, so nothing was changed. A speaker that has just reconnected usually needs a minute to settle — try again shortly."
msgstr "Els dos altaveus estan massa desfasats i no es canvia res. Un altaveu que s'acaba de reconnectar triga un minut a estabilitzar-se. Intenteu-ho d'aquí un moment."

#: package/contents/ui/SyncEngine.qml:917
msgid "The reading would not settle even with the speakers turned up — nothing was changed. Trying again usually does it."
msgstr "La lectura no s'ha estabilitzat fins i tot amb els altaveus engegats. No es canvia res. Normalment, només cal intentar-ho una altra vegada."

#: package/contents/ui/SyncEngine.qml:921
msgid "Make sure the microphone is not covered and both speakers can be heard, then try again."
msgstr "Assegureu-vos que el micròfon no està cobert i que ambdós altaveus es poden sentir bé. Quan ho hagueu fet, intenteu-ho de nou."

#: package/contents/ui/SyncEngine.qml:955
#: package/contents/ui/SyncEngine.qml:1003
#: package/contents/ui/SyncEngine.qml:1038
#: package/contents/ui/SyncEngine.qml:1132
#: package/contents/ui/SyncEngine.qml:1165
#: package/contents/ui/SyncEngine.qml:1188
#: package/contents/ui/SyncEngine.qml:1194
#: package/contents/ui/SyncEngine.qml:1220
#: package/contents/ui/SyncEngine.qml:1235
#: package/contents/ui/SyncEngine.qml:1281
#: package/contents/ui/SyncEngine.qml:1286
#: package/contents/ui/SyncEngine.qml:1293
#: package/contents/ui/SyncEngine.qml:1306
msgid "Sync check"
msgstr "Prova de sincronització"

#: package/contents/ui/SyncEngine.qml:956
msgid "%1 is muted, so the check skipped it. Unmute it and check again to include it."
msgstr "%1 està silenciat i per això se'l salta a la prova. Caldrà activar-lo de nou per a incloure'l."

#: package/contents/ui/SyncEngine.qml:1004
msgid "The speakers were %1 ms apart — measuring once more to confirm."
msgstr "Els altaveus estaven a %1 ms de diferència. Es torna a mesurar per a confirmar-ho."

#: package/contents/ui/SyncEngine.qml:1039
msgid "Two measurements disagreed about the room, so nothing was changed. If the speakers sound apart, press Calibrate."
msgstr "Dues mesures no han coincidit. De manera que no es canvia res. Si els altaveus sonen dessincronitzats, premeu «Calibra»."

#: package/contents/ui/SyncEngine.qml:1133
msgid "The room still reads %1 ms apart, but the difference sits on the wired speaker's road, which does not drift by itself — nothing was changed. If the speakers sound apart, press Calibrate."
msgstr "Les mesures encara mostren una diferència de %1 ms, que està dins del que cal esperar per a altaveus amb cable, que no varien per si soles. No es canvia res. Si els altaveus sonen dessincronitzats, premeu «Calibra»."

#: package/contents/ui/SyncEngine.qml:1137
msgid "The speakers were %1 ms apart — adjusted from the measurement, checking once more."
msgstr "Els altaveus estaven a %1 ms de diferència. S'ajusten segons la mesura i es comprovarà una vegada més."

#: package/contents/ui/SyncEngine.qml:1155
msgid "A speaker's route was stuck %1 ms behind — flushed it, checking once more."
msgstr "La ruta d'un altaveu anava endarrerida %1 ms. S'ha buidat i es torna a comprovar."

#: package/contents/ui/SyncEngine.qml:1189
msgid "The check compares speakers, and too many are muted to compare. Unmute them and check again."
msgstr "La prova compara els altaveus i n'hi ha massa en silenci. Desactiveu l'opció «Silencia» de cadascun d'aquests i intenteu-ho de nou."

#: package/contents/ui/SyncEngine.qml:1195
msgid "This speaker does not carry the inaudible test tone, so the check needed the audible one — and the room was too noisy for it. Pause other audio and try again."
msgstr "Aquest altaveu no reprodueix el to inaudible de prova, així que la prova ha necessitat el to audible. No obstant, l'entorn era massa sorollós. Feu silenci a l'entorn i intenteu-ho de nou."

#: package/contents/ui/SyncEngine.qml:1213
msgid "Sync check skipped"
msgstr "S'ha omès la comprovació de sincronització"

#: package/contents/ui/SyncEngine.qml:1214
msgid "The speakers here do not carry the inaudible tone to the microphone. Move the microphone closer, or turn off \"Measure with a tone too high to hear\" to use the audible clicks."
msgstr "El to inaudible de prova dels altaveus no arriba al micròfon. Moveu el micròfon més a prop o desactiveu «Mesura amb un to massa agut per a sentir-lo»."

#: package/contents/ui/SyncEngine.qml:1216
msgid "Auto-check: cannot measure without a sound you would hear"
msgstr "Autocomprovació: no es pot mesurar sense un so audible."

#: package/contents/ui/SyncEngine.qml:1236
msgid "The reading from %1 would not settle, so nothing was changed. Trying again usually does it."
msgstr "La lectura de %1 no s'ha estabilitzat i no es canvia res. Normalment, només cal intentar-ho una altra vegada."

#: package/contents/ui/SyncEngine.qml:1282
msgid "%1 stayed silent through both rounds — it was left out of the group. Tick it back in the speaker list any time."
msgstr "%1 s'ha quedat en silenci ambdues rondes. S'ha tret del grup. Marqueu-lo de nou a la llista d'altaveus quan vulgueu recuperar-lo."

#: package/contents/ui/SyncEngine.qml:1287
msgid "%1 made no sound the microphone could hear. If it stays silent on the next calibration too, it will be left out of the group."
msgstr "%1 no ha fet cap so que el micròfon pogués detectar. Si continua en silenci a la propera calibració, es traurà del grup."

#: package/contents/ui/SyncEngine.qml:1294
msgid "Could not hear %1 during the check — the speaker may be muted or off. The calibration was kept."
msgstr "No s'ha sentit a %1 durant la prova. L'altaveu potser està en silenci o apagat. Es manté la seva calibració."

#: package/contents/ui/SyncEngine.qml:1302
msgid "Sync verified"
msgstr "Sincronia verificada"

#: package/contents/ui/SyncEngine.qml:1303
msgid "Every speaker arrives within %1 ms at the microphone — in step to the ear."
msgstr "Els altaveus arriben al micròfon dins d'un marge de %1 ms. Per a l'oïda humana, estan sincronitzats."

#: package/contents/ui/SyncEngine.qml:1307
msgid "The speakers still arrive %1 ms apart. Calibrate once more, or nudge the delay slider."
msgstr "Els altaveus arriben amb una diferència de %1 ms. Torneu-los a calibrar o ajusteu el control lliscant d'endarreriment."

#: package/contents/ui/SyncEngine.qml:1344
msgid "Auto-check %1: skipped, something else was using the speakers"
msgstr "Autocomprovació %1: Se salta, ja que una altra entitat fa servir els altaveus."

#: package/contents/ui/SyncEngine.qml:1369
#: package/contents/ui/SyncEngine.qml:1423
msgid "Auto-check %1: settling after the adjustment"
msgstr "Autocomprovació %1: S'estabilitza després de l'ajust"

#: package/contents/ui/SyncEngine.qml:1396
msgid "Auto-check %1: reading would not settle — the microphone may be too far from the speakers"
msgstr "Autocomprovació %1: Les lectures no s'estabilitzen. Potser el micròfon està massa lluny dels altaveus."

#: package/contents/ui/SyncEngine.qml:1400
msgid "Auto-check %1: too quiet to tell"
msgstr "Autocomprovació %1: Massa silenci per a dir res"

#: package/contents/ui/SyncEngine.qml:1474
msgid "Auto-check %1: in sync — measured %2 ms"
msgstr "Autocomprovació %1: En sincronia. S'ha mesurat %2 ms."

#: package/contents/ui/SyncEngine.qml:1475
msgid "Auto-check %1: in sync"
msgstr "Autocomprovació %1: En sincronia"

#: package/contents/ui/SyncEngine.qml:1485
msgid "Auto-check %1: %2 ms apart — measured %3 ms"
msgstr "Autocomprovació %1: %2 ms de desfasament. S'ha mesurat %3 ms."

#: package/contents/ui/SyncEngine.qml:1486
msgid "Auto-check %1: still %2 ms apart (0 = in step)"
msgstr "Autocomprovació %1: Encara hi ha %2 ms de desfasament (0 = sincronitzat)."

#: package/contents/ui/SyncEngine.qml:1523
msgid "Sync has drifted"
msgstr "La sincronia s'ha desviat"

#: package/contents/ui/SyncEngine.qml:1524
msgid "The speakers are audibly apart again — run Calibrate when convenient."
msgstr "Els altaveus es tornen a sentir desfasats. Executeu de nou la calibració quan pugueu."

#: package/contents/ui/SyncEngine.qml:1633
msgid "Speaker timing drifted"
msgstr "La temporització de l'altaveu s'ha desviat"

#: package/contents/ui/SyncEngine.qml:1634
msgid "A Bluetooth speaker came back noticeably off its calibration — the sync compensated automatically. Recalibrate when convenient for exact ears."
msgstr "Un altaveu Bluetooth s'ha descalibrat. La sincronització ho ha compensat automàticament. Torneu a calibrar quan pugueu per a millorar el resultat."

#: package/contents/ui/SyncEngine.qml:2232
#: package/contents/ui/SyncEngine.qml:2331
msgid "Auto-check: listening…"
msgstr "Autocomprovació: S'escolta…"

#: package/contents/ui/SyncEngine.qml:2302
msgid "Auto-check %1: only one speaker can hear the inaudible tone — nothing to compare"
msgstr "Autocomprovació %1: Només es pot sentir el to inaudible des d'un altaveu. No hi ha res a comparar."

#: package/contents/ui/SyncEngine.qml:2349
msgid "Auto-check %1: no answer came back"
msgstr "Autocomprovació %1: No s'ha rebut cap resposta."

#: package/contents/ui/SyncEngine.qml:2391
msgid "%1: %2 ms"
msgstr "%1: %2 ms"

#. i18n() is given at runtime and the translation is
#. silently skipped in every language.
#: package/contents/ui/SyncEngine.qml:2872
msgid "Sync measurement"
msgstr "Mesura de sincronia"

#: package/contents/ui/SyncEngine.qml:2873
msgid "A recording is running. The measurement plays test tones and quiets the speakers, so it waits until the recording is done."
msgstr "Hi ha una gravació en curs. Les mesures reprodueixen tons de prova i posen els altaveus en silenci. Per això, s'espera a què acabi la reproducció."

#: package/contents/ui/SyncEngine.qml:3050
msgid "Measuring with a tone too high to hear — about two minutes in total. The music stays silent until the check finishes."
msgstr "Es mesura amb un to massa agut per a sentir-lo. Es trigarà uns dos minuts en total. La música es manté en silenci fins que acabi la prova."

#: package/contents/ui/SyncEngine.qml:3051
msgid "Two rounds of clicks with a quiet check between them — about two minutes in total. The music stays silent until the check finishes."
msgstr "Dues rondes de clics amb una prova de silenci entre rondes. Uns dos minuts en total. La música es manté en silenci fins que acabi la prova."

#: package/contents/ui/SyncEngine.qml:3053
msgid "Skipped (empty jack): %1."
msgstr "Omès (connector buit): %1."

#: package/contents/ui/SyncEngine.qml:3054
msgid "Calibration started"
msgstr "Calibració iniciada"

#: package/contents/ui/SyncEngine.qml:3121
msgid "All local outputs (On Air)"
msgstr "Totes les sortides locals (On Air)"

#: package/contents/ui/SyncEngine.qml:3916
msgid "Auto-check: measured %1 ms — takes effect the next time the music pauses"
msgstr "Autocomprovació: S'han mesurat %1 ms. S'aplicarà la propera vegada que es posi la música en pausa."

#: package/contents/ui/SyncEngine.qml:3917
msgid "Auto-check: adjusted — takes effect the next time the music pauses"
msgstr "Autocomprovació: Ajustada. S'aplicarà la propera vegada que es posi la música en pausa."

#: package/contents/ui/SyncEngine.qml:4426
msgid "%1 did not join the sync"
msgstr "%1 no s'ha unit a la sincronització."

#: package/contents/ui/SyncEngine.qml:4428
msgid "The speaker is connected but could not be pulled into the group — switch the sync off and on to rebuild it."
msgstr "L'altaveu està connectat però no s'ha pogut incorporar al grup. Desactiveu i torneu a activar la sincronització per a tornar-ho a intentar."

#: package/contents/ui/SyncEngine.qml:4429
msgid "The speaker is connected but its audio output never appeared — switch the speaker off and on, then connect it again."
msgstr "L'altaveu està connectat, però la seva sortida de so no s'ha sentit. Apagueu i torneu a engegar l'altaveu i connecteu-lo de nou."

#: package/contents/ui/TimeshiftEngine.qml:387
msgid "Not enough free disk space"
msgstr "No hi ha prou espai lliure al disc"

#~ msgid "Surprise me"
#~ msgstr "Sorprèn-me"

#~ msgid "Tune in somewhere on Earth — a random country's top station starts playing"
#~ msgstr "Sintonitza amb qualsevol lloc de la Terra. Es reproduirà la millor emissora d'algun país aleatori."

#~ msgid "Saved to: %1"
#~ msgstr "Desat a: %1"

#~ msgid "The room was not quiet enough to verify — pause other audio and calibrate once more."
#~ msgstr "Hi havia massa soroll a l'habitació per a verificar-ho. Pareu els sorolls i calibreu-ho de nou."

#~ msgid "Speakers drifted — checking sync. Music pauses for about a minute."
#~ msgstr "Els altaveus s'han dessincronitzat. Es comprova la sincronia. La música pararà durant un minut."

#: package/contents/ui/config/configAppearance.qml:159
msgid "Automatically switch to the highest-bitrate variant of a station"
msgstr "Canvia automàticament a la variant de l'emissora amb la taxa de bits més alta"

#: package/contents/ui/config/configAppearance.qml:162
msgid "Looks the station up on radio-browser.info and picks the best-quality stream URL"
msgstr "Cerca l'estació al radio-browser.info i escull la URL de l'emissió de més qualitat"

#: package/contents/ui/config/configAppearance.qml:167
msgid "Find a station's new address when its stream dies"
msgstr "Troba la nova adreça de l'emissora quan el flux s'interromp"

#: package/contents/ui/config/configAppearance.qml:170
msgid "Stations move servers; when playback fails, the station is looked up on radio-browser.info and the address it is reachable at now is saved to your list"
msgstr "Les emissores canvien de servidor. Quan falla la reproducció, l'emissora es busca a radio-browser.info i l'adreça que funcioni es desa a la llista."

#: package/contents/ui/config/configAppearance.qml:175
msgid "Count my listening in the worldwide station catalog"
msgstr "Compta la meva reproducció al catàleg d'emissores mundials"

#: package/contents/ui/config/configAppearance.qml:178
msgid "When a station starts playing, a click is reported to radio-browser.info — the request carries the station id only, no account or personal data is added; popular stations become easier to find for everyone"
msgstr "Quan es comença a reproduir una emissora, s'envia la informació corresponent a radio-browser.info — la petició només envia informació de l'id d'emissora, no conté dades personals o del compte—; això permet que tothom pugui trobar més fàcilment les emissores més populars."


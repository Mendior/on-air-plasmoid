#: package/contents/ui/main.qml:3741
msgid "Turn the speaker off and on again, then reconnect it."
msgstr "Stäng av och sätt på högtalaren igen och anslut den sedan på nytt."

#: package/contents/ui/main.qml:4200
msgid "Station seems to be off the air"

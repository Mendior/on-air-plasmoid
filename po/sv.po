msgstr "%1 enheter"

#: package/contents/ui/main.qml:3740
msgid "The Bluetooth speaker"
msgstr "Bluetooth-högtalaren"

#: package/contents/ui/main.qml:3739
msgid "%1 is connected, but its sound never arrived"

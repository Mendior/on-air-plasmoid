msgstr "Kunde inte casta till %1"

#: package/contents/ui/main.qml:5801
msgid "The device could not play this station."
msgstr "Enheten kunde inte spela den här stationen."

#: package/contents/ui/main.qml:5847
msgid "Casting"
msgstr "Strömning"

#: package/contents/ui/main.qml:5848
msgid "The device did not stop — it may still be playing."
msgstr "Enheten stoppade inte — den kan fortfarande spela."

#: package/contents/ui/main.qml:5926
msgid "Bluetooth is switched off"
msgstr "Bluetooth är avstängt"

#: package/contents/ui/main.qml:5927
msgid "The adapter would not turn on — check the system tray's Bluetooth switch or System Settings."
msgstr "Adaptern ville inte slås på — kontrollera Bluetooth-knappen i systembrickan eller Systeminställningar."

#: package/contents/ui/main.qml:5946 package/contents/ui/main.qml:6064

msgstr "Kontrollera programmen efter nya avsnitt:"

#: package/contents/ui/config/configAutomation.qml:45
msgid "Never"
msgstr "Aldrig"

#: package/contents/ui/config/configAutomation.qml:46
msgid "Every 6 hours"
msgstr "Var 6:e timme"

#: package/contents/ui/config/configAutomation.qml:47
msgid "Every 12 hours"
msgstr "Var 12:e timme"

#: package/contents/ui/config/configAutomation.qml:48
msgid "Once a day"

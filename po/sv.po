msgstr "Spelar från en reservadress"

#: package/contents/ui/main.qml:4278
msgid "The station's saved address is not answering — playing the directory's closest match for now. Your saved address was kept."
msgstr "Stationens sparade adress svarar inte — spelar tills vidare närmaste träff från katalogen. Din sparade adress behölls."

#: package/contents/ui/main.qml:4318
msgid "Station found at a new address"
msgstr "Stationen hittad på en ny adress"

#: package/contents/ui/main.qml:4319
msgid "%1 moved — the new address was saved to your list."
msgstr "%1 har flyttat — den nya adressen sparades i din lista."

#: package/contents/ui/main.qml:5778
msgid "Casting needs pychromecast"
msgstr "Casting kräver pychromecast"

#: package/contents/ui/main.qml:5779
msgid "Install the pychromecast library to cast to your devices."
msgstr "Installera biblioteket pychromecast för att casta till dina enheter."

#: package/contents/ui/main.qml:5800

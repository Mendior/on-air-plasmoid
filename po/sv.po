#: package/contents/ui/main.qml:6163 package/contents/ui/main.qml:6238
msgid "yt-dlp is not installed"
msgstr "yt-dlp är inte installerat"

#: package/contents/ui/main.qml:6164 package/contents/ui/main.qml:6239
msgid "Install yt-dlp (and ffmpeg) to download tracks."
msgstr "Installera yt-dlp (och ffmpeg) för att ladda ner spår."

#: package/contents/ui/main.qml:6188 package/contents/ui/main.qml:6258
msgid "Nothing found to download"
msgstr "Inget att ladda ner hittades"

#: package/contents/ui/main.qml:6189

#: package/contents/ui/main.qml:6190 package/contents/ui/main.qml:6259
msgid "No track matched \"%1\" — a show or album title often has no single track to find."
msgstr "Inget spår matchade \"%1\" — bakom ett program- eller albumnamn finns ofta inget enskilt spår."

#: package/contents/ui/main.qml:6202
msgid "Found only a different show — skipped"
msgstr "Hittade bara ett annat program — hoppades över"

#: package/contents/ui/main.qml:6203
msgid "Best match for \"%1\" was \"%2\". Not downloading the wrong one."
msgstr "Bästa träffen för \"%1\" var \"%2\". Fel program laddas inte ner."

#: package/contents/ui/main.qml:6225
msgid "Downloading again without the cover"
msgstr "Laddar ner igen utan omslag"

#: package/contents/ui/main.qml:6226
msgid "Embedding tags needs the python-mutagen package — install it to get covers in your files."
msgstr "Inbäddning av taggar kräver paketet python-mutagen — installera det för att få omslag i dina filer."


#: package/contents/ui/main.qml:4267
msgid "%1 is not answering at any address the directory knows. It stays in your list — trying again in the background."
msgstr "%1 ei vastaa yhdestäkään hakemiston tuntemasta osoitteesta. Se säilyy luettelossasi — yritetään uudelleen taustalla."

#: package/contents/ui/main.qml:4380
msgid "Playing from a backup address"
msgstr "Toistetaan varaosoitteesta"

#: package/contents/ui/main.qml:4381
msgid "The station's saved address is not answering — playing the directory's closest match for now. Your saved address was kept."
msgstr "Aseman tallennettu osoite ei vastaa — toistetaan toistaiseksi hakemiston lähintä vastinetta. Tallennettu osoitteesi säilytettiin."

#: package/contents/ui/main.qml:4421
msgid "Station found at a new address"
msgstr "Asema löytyi uudesta osoitteesta"

#: package/contents/ui/main.qml:4422
msgid "%1 moved — the new address was saved to your list."
msgstr "%1 on muuttanut — uusi osoite tallennettiin luetteloosi."

#: package/contents/ui/main.qml:5896
msgid "Casting needs pychromecast"
msgstr "Lähettäminen vaatii pychromecastia"

#: package/contents/ui/main.qml:5897
msgid "Install the pychromecast library to cast to your devices."
msgstr "Asenna pychromecast-kirjasto, jotta voit lähettää ääntä laitteillesi."

#: package/contents/ui/main.qml:5918
msgid "the device"
msgstr "laite"

#: package/contents/ui/main.qml:5918
msgid "Could not cast to %1"
msgstr "Ei voitu lähettää laitteelle %1"

#: package/contents/ui/main.qml:5919
msgid "The device could not play this station."
msgstr "Laite ei voinut toistaa tätä asemaa."

#: package/contents/ui/main.qml:5965
msgid "Casting"
msgstr "Lähetetään"

#: package/contents/ui/main.qml:5966
msgid "The device did not stop — it may still be playing."
msgstr "Laite ei pysähtynyt — se saattaa yhä toistaa."

#: package/contents/ui/main.qml:6044
msgid "Bluetooth is switched off"
msgstr "Bluetooth on pois päältä"

#: package/contents/ui/main.qml:6045
msgid "The adapter would not turn on — check the system tray's Bluetooth switch or System Settings."
msgstr "Sovitin ei käynnistynyt — tarkista ilmoitusalueen Bluetooth-kytkin tai järjestelmäasetukset."

#: package/contents/ui/main.qml:6064 package/contents/ui/main.qml:6182
msgid "the Bluetooth device"
msgstr "Bluetooth-laite"

#: package/contents/ui/main.qml:6063
msgid "Could not connect to %1"
msgstr "Ei voitu yhdistää laitteeseen %1"

#: package/contents/ui/main.qml:6065
msgid "Make sure the speaker is switched on and in range."
msgstr "Varmista, että kaiutin on päällä ja kantaman sisällä."

#: package/contents/ui/main.qml:6181
msgid "Could not pair with %1"
msgstr "Laiteparia ei voitu muodostaa laitteen %1 kanssa"

#: package/contents/ui/main.qml:6183
msgid "Put the speaker in pairing mode (hold its Bluetooth button) and try again."
msgstr "Aseta kaiutin paritustilaan (pidä sen Bluetooth-painiketta pohjassa) ja yritä uudelleen."

#: package/contents/ui/main.qml:6281 package/contents/ui/main.qml:6355
msgid "yt-dlp is not installed"
msgstr "yt-dlp ei ole asennettu"

#: package/contents/ui/main.qml:6282 package/contents/ui/main.qml:6356
msgid "Install yt-dlp (and ffmpeg) to download tracks."
msgstr "Asenna yt-dlp (ja ffmpeg) ladataksesi kappaleita."

#: package/contents/ui/main.qml:6305 package/contents/ui/main.qml:6375
msgid "Nothing found to download"
msgstr "Ladattavaa ei löytynyt"

#: package/contents/ui/main.qml:6306
msgid "yt-dlp could not search: %1"
msgstr "yt-dlp ei voinut hakea: %1"

#: package/contents/ui/main.qml:6307 package/contents/ui/main.qml:6376
msgid "No track matched \"%1\" — a show or album title often has no single track to find."
msgstr "Mikään kappale ei vastannut hakua \"%1\" — ohjelman tai albumin nimen takana ei usein ole yhtä kappaletta."

#: package/contents/ui/main.qml:6319
msgid "Found only a different show — skipped"
msgstr "Löytyi vain eri ohjelma — ohitettiin"

#: package/contents/ui/main.qml:6320
msgid "Best match for \"%1\" was \"%2\". Not downloading the wrong one."
msgstr "Paras osuma haulle \"%1\" oli \"%2\". Väärää ei ladata."

#: package/contents/ui/main.qml:6342
msgid "Downloading again without the cover"
msgstr "Ladataan uudelleen ilman kansikuvaa"

#: package/contents/ui/main.qml:6343
msgid "Embedding tags needs the python-mutagen package — install it to get covers in your files."
msgstr "Tunnisteiden upottaminen vaatii python-mutagen-paketin — asenna se saadaksesi kansikuvat tiedostoihisi."

#: package/contents/ui/main.qml:6371
msgid "Track downloaded ✓"
msgstr "Kappale ladattu ✓"

#: package/contents/ui/main.qml:6372
msgid "Saved as \"%1\" — newest first in My Music"
msgstr "Tallennettu nimellä \"%1\" — uusin ensin Oma musiikki -sivulla"

#: package/contents/ui/main.qml:6380
msgid "Download failed"
msgstr "Lataus epäonnistui"

#: package/contents/ui/main.qml:6381
msgid "Unknown error"
msgstr "Tuntematon virhe"

#: package/contents/ui/main.qml:6846
msgid "Audio output changed"
msgstr "Äänilähtö vaihtui"

#: package/contents/ui/main.qml:6847
msgid "The chosen output device disappeared — using the system default instead."
msgstr "Valittu äänilaite katosi — käytetään sen sijaan järjestelmän oletusta."

#: package/contents/ui/MediaListItem.qml:496
msgid "Click again to confirm removal"
msgstr "Vahvista poisto napsauttamalla uudelleen"

#: package/contents/ui/MediaListItem.qml:497
msgid "Remove station from list"
msgstr "Poista asema luettelosta"

#: package/contents/ui/MediaListItem.qml:571
msgid "Waiting for track info…"
msgstr "Odotetaan kappaletietoja…"


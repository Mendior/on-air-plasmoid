msgstr "Tilaukset viety"

#: package/contents/ui/PodcastEngine.qml:211
msgid "Export failed"
msgstr "Vienti epäonnistui"

#: package/contents/ui/PodcastEngine.qml:212
msgid "Could not write the subscriptions file."
msgstr "Tilaustiedostoa ei voitu kirjoittaa."

#: package/contents/ui/PodcastEngine.qml:251
msgid "Episode downloaded"
msgstr "Jakso ladattu"

#: package/contents/ui/PodcastEngine.qml:256
#: package/contents/ui/PodcastEngine.qml:1158
msgid "Episode download failed"
msgstr "Jakson lataus epäonnistui"

#: package/contents/ui/PodcastEngine.qml:415
msgid "Nothing to export"
msgstr "Ei vietävää"

#: package/contents/ui/PodcastEngine.qml:415
msgid "Subscribe to a show first."
msgstr "Tilaa ensin jokin ohjelma."

#: package/contents/ui/PodcastEngine.qml:447
msgid "Subscriptions imported"
msgstr "Tilaukset tuotu"

#: package/contents/ui/PodcastEngine.qml:448
msgid "%1 show added"
msgid_plural "%1 shows added"
msgstr[0] "%1 ohjelma lisätty"
msgstr[1] "%1 ohjelmaa lisätty"

#: package/contents/ui/PodcastEngine.qml:450
msgid "Nothing imported"
msgstr "Mitään ei tuotu"

#: package/contents/ui/PodcastEngine.qml:451
msgid "No new podcast feeds were found in that file."
msgstr "Tiedostosta ei löytynyt uusia podcast-syötteitä."

#: package/contents/ui/PodcastEngine.qml:861
#: package/contents/ui/PodcastEngine.qml:903
msgid "This feed address is not allowed."
msgstr "Tämä syöteosoite ei ole sallittu."

#: package/contents/ui/PodcastEngine.qml:930
#: package/contents/ui/PodcastEngine.qml:979
msgid "The feed could not be reached — check the connection and try again."
msgstr "Syötettä ei tavoitettu — tarkista yhteys ja yritä uudelleen."

#: package/contents/ui/PodcastEngine.qml:932
#: package/contents/ui/PodcastEngine.qml:981
msgid "The feed did not answer (error %1)."
msgstr "Syöte ei vastannut (virhe %1)."

#: package/contents/ui/PodcastEngine.qml:933
#: package/contents/ui/PodcastEngine.qml:982
msgid "This address is not a podcast feed."
msgstr "Tämä osoite ei ole podcast-syöte."

#: package/contents/ui/PodcastEngine.qml:945
msgid "No playable episodes in this feed."
msgstr "Syötteessä ei ole toistettavia jaksoja."

#: package/contents/ui/PodcastEngine.qml:1344
msgid "%1 — the newest episodes are downloading."
msgstr "%1 — uusimpia jaksoja ladataan."

#: package/contents/ui/PodcastEngine.qml:1346
msgid "New podcast episodes"
msgstr "Uusia podcast-jaksoja"

#: package/contents/ui/RecordingEngine.qml:235
#: package/contents/ui/RecordingEngine.qml:509
#: package/contents/ui/RecordingEngine.qml:579
msgid "Recording failed"
msgstr "Nauhoitus epäonnistui"

#: package/contents/ui/RecordingEngine.qml:413
msgid "Scheduled recording missed"
msgstr "Ajastettu tallennus jäi väliin"

#: package/contents/ui/RecordingEngine.qml:419
msgid "Scheduled recording skipped"
msgstr "Ajastettu tallennus ohitettiin"

#: package/contents/ui/RecordingEngine.qml:420
msgid "%1 — another recording is already running."
msgstr "%1 — toinen tallennus on jo käynnissä."

#: package/contents/ui/RecordingEngine.qml:515
msgid "Scheduled recording started"
msgstr "Ajastettu tallennus käynnistyi"

#: package/contents/ui/RecordingEngine.qml:555
msgid "ffmpeg is not installed"
msgstr "ffmpeg ei ole asennettuna"

#: package/contents/ui/RecordingEngine.qml:556
msgid "Install ffmpeg to record radio."
msgstr "Asenna ffmpeg, jotta voit tallentaa radiota."

#: package/contents/ui/RecordingEngine.qml:561
msgid "curl is not installed"
msgstr "curl ei ole asennettuna"

#: package/contents/ui/RecordingEngine.qml:562
msgid "Install curl to record radio."
msgstr "Asenna curl, jotta voit tallentaa radiota."

#: package/contents/ui/RecordingEngine.qml:565
msgid "Not enough disk space for this recording"
msgstr "Levytila ei riitä tähän tallennukseen"

#: package/contents/ui/RecordingEngine.qml:566
msgid "Free some space in %1 and try again."
msgstr "Vapauta tilaa kohteessa %1 ja yritä uudelleen."

#: package/contents/ui/RecordingEngine.qml:569
msgid "Recording saved ✓ (%1)"
msgstr "Nauhoitus tallennettu ✓ (%1)"

#: package/contents/ui/RecordingEngine.qml:573
msgid "Recording interrupted (%1 captured)"
msgstr "Nauhoitus keskeytyi (%1 tallentui)"

#: package/contents/ui/RecordingEngine.qml:575
msgid "%1 — the file is much smaller than expected."
msgstr "%1 — tiedosto on paljon odotettua pienempi."

#: package/contents/ui/RecordingEngine.qml:580
msgid "The stream could not be captured."
msgstr "Suoratoistoa ei voitu tallentaa."

#: package/contents/ui/SyncEngine.qml:403
msgid "Could not combine the outputs"
msgstr "Äänilähtöjä ei voitu yhdistää"

#: package/contents/ui/SyncEngine.qml:404
msgid "pactl refused to create the combined output."
msgstr "pactl ei suostunut luomaan yhdistettyä äänilähtöä."

#: package/contents/ui/SyncEngine.qml:655
msgid "Auto-check %1: room put back in step"
msgstr "Automaattitarkistus %1: huone taas synkronissa"

#: package/contents/ui/SyncEngine.qml:924
msgid "The Bluetooth speaker trails by %1 ms, and every speaker's loudness was matched at the microphone — all set and remembered."
msgstr "Bluetooth-kaiutin on %1 ms jäljessä, ja jokaisen kaiuttimen äänenvoimakkuus tasattiin mikrofonin kohdalla — kaikki asetettu ja muistissa."

#: package/contents/ui/SyncEngine.qml:925
msgid "The Bluetooth speaker trails by %1 ms — the delay is set and remembered for this device."
msgstr "Bluetooth-kaiutin on %1 ms jäljessä — viive on asetettu ja muistetaan tälle laitteelle."

#: package/contents/ui/SyncEngine.qml:927
msgid "Balance levels set earlier were replaced by the measured ones."
msgstr "Aiemmin asetetut tasapainotasot korvattiin mitatuilla."

#: package/contents/ui/SyncEngine.qml:933
msgid "The speakers were matched to the quietest one and the group's volume was raised by %1% to make up for it."
msgstr "Kaiuttimet tasattiin hiljaisimman mukaan ja ryhmän äänenvoimakkuutta nostettiin %1% sen korvaamiseksi."

#: package/contents/ui/SyncEngine.qml:934
msgid "The speakers were matched to the quietest one, so the room is quieter than before — turn the volume up if you want it back."
msgstr "Kaiuttimet tasattiin hiljaisimman mukaan, joten huone on aiempaa hiljaisempi — nosta äänenvoimakkuutta, jos haluat sen takaisin."

#: package/contents/ui/SyncEngine.qml:943
msgid "The microphone clipped on %1 — that balance was left unchanged; lower the speaker's volume and calibrate again."
msgstr "Mikrofonin ääni leikkautui kaiuttimella %1 — sen tasapaino jätettiin ennalleen; pienennä kaiuttimen äänenvoimakkuutta ja kalibroi uudelleen."

#: package/contents/ui/SyncEngine.qml:956
msgid "Measured with %1 — the default microphone stayed silent."
msgstr "Mitattiin mikrofonilla %1 — oletusmikrofoni pysyi hiljaisena."

#: package/contents/ui/SyncEngine.qml:957
msgid "Speakers calibrated"
msgstr "Kaiuttimet kalibroitu"

#: package/contents/ui/SyncEngine.qml:970
#: package/contents/ui/SyncEngine.qml:978
#: package/contents/ui/SyncEngine.qml:1039
#: package/contents/ui/SyncEngine.qml:1047
#: package/contents/ui/SyncEngine.qml:1051
msgid "Calibration did not succeed"
msgstr "Kalibrointi ei onnistunut"

#: package/contents/ui/SyncEngine.qml:971
msgid "The inaudible tone did not reach the microphone from these speakers. Move the microphone closer, or turn off \"Measure with a tone too high to hear\" to measure with the audible clicks."
msgstr "Kuulumaton ääni ei kantanut näistä kaiuttimista mikrofonille. Siirrä mikrofoni lähemmäs tai poista käytöstä ”Mittaa äänellä, jota ei kuule”, niin mittaus tehdään kuuluvilla napsautuksilla."

#: package/contents/ui/SyncEngine.qml:979
#: package/contents/ui/SyncEngine.qml:1411
msgid "Every microphone delivered pure silence. A mic's own mute button is invisible to the system — check the light on the microphone itself, or set a working microphone as the default."
msgstr "Kaikki mikrofonit tuottivat pelkkää hiljaisuutta. Mikrofonin oma mykistyspainike ei näy järjestelmälle — tarkista mikrofonin oma merkkivalo tai aseta toimiva mikrofoni oletukseksi."

#: package/contents/ui/SyncEngine.qml:1011
msgid "Calibration"
msgstr "Kalibrointi"

#: package/contents/ui/SyncEngine.qml:1013
msgid "The inaudible reading would not settle at this level — trying once more, louder."
msgstr "Kuulumaton lukema ei asettunut tällä tasolla — yritetään vielä kerran, kovempaa."

#: package/contents/ui/SyncEngine.qml:1014
msgid "The clicks were too quiet for this room — trying once more, louder."
msgstr "Naksahdukset olivat tähän huoneeseen liian hiljaisia — yritetään vielä kerran kovemmalla äänellä."

#: package/contents/ui/SyncEngine.qml:1040
msgid "The two speakers timed impossibly far apart, so nothing was changed. A speaker that has just reconnected usually needs a minute to settle — try again shortly."
msgstr "Kaiuttimet mitattiin mahdottoman kauas toisistaan, joten mitään ei muutettu. Juuri uudelleen yhdistetty kaiutin tarvitsee yleensä minuutin asettuakseen — yritä pian uudelleen."

#: package/contents/ui/SyncEngine.qml:1048
msgid "The reading would not settle even with the speakers turned up — nothing was changed. Trying again usually does it."
msgstr "Lukema ei asettunut edes kaiuttimet kovemmalla — mitään ei muutettu. Uusi yritys yleensä riittää."

#: package/contents/ui/SyncEngine.qml:1052
msgid "Make sure the microphone is not covered and both speakers can be heard, then try again."
msgstr "Varmista, ettei mikrofoni ole peitossa ja että molemmat kaiuttimet kuuluvat, ja yritä sitten uudelleen."

#: package/contents/ui/SyncEngine.qml:1086
#: package/contents/ui/SyncEngine.qml:1134
#: package/contents/ui/SyncEngine.qml:1169
#: package/contents/ui/SyncEngine.qml:1322
#: package/contents/ui/SyncEngine.qml:1355
#: package/contents/ui/SyncEngine.qml:1378
#: package/contents/ui/SyncEngine.qml:1384
#: package/contents/ui/SyncEngine.qml:1410
#: package/contents/ui/SyncEngine.qml:1425
#: package/contents/ui/SyncEngine.qml:1471
#: package/contents/ui/SyncEngine.qml:1476
#: package/contents/ui/SyncEngine.qml:1483
#: package/contents/ui/SyncEngine.qml:1496
msgid "Sync check"
msgstr "Synkronoinnin tarkistus"

#: package/contents/ui/SyncEngine.qml:1087
msgid "%1 is muted, so the check skipped it. Unmute it and check again to include it."
msgstr "%1 on mykistetty, joten tarkistus ohitti sen. Poista mykistys ja tarkista uudelleen, niin se otetaan mukaan."

#: package/contents/ui/SyncEngine.qml:1135
msgid "The speakers were %1 ms apart — measuring once more to confirm."
msgstr "Kaiuttimet olivat %1 ms erillään — mitataan vielä kerran varmistukseksi."

#: package/contents/ui/SyncEngine.qml:1170
msgid "Two measurements disagreed about the room, so nothing was changed. If the speakers sound apart, press Calibrate."
msgstr "Kaksi mittausta olivat eri mieltä huoneesta, joten mitään ei muutettu. Jos kaiuttimet kuulostavat eriaikaisilta, paina Kalibroi."

#: package/contents/ui/SyncEngine.qml:1323
msgid "The room still reads %1 ms apart, but the difference sits on the wired speaker's road, which does not drift by itself — nothing was changed. If the speakers sound apart, press Calibrate."
msgstr "Huone näyttää yhä %1 ms eroa, mutta ero istuu johdollisen kaiuttimen reitillä, joka ei ajaudu itsestään — mitään ei muutettu. Jos kaiuttimet kuulostavat eriaikaisilta, paina Kalibroi."

#: package/contents/ui/SyncEngine.qml:1327
msgid "The speakers were %1 ms apart — adjusted from the measurement, checking once more."
msgstr "Kaiuttimien välillä oli %1 ms ero — säädettiin mittauksen perusteella, tarkistetaan vielä kerran."

#: package/contents/ui/SyncEngine.qml:1345
msgid "A speaker's route was stuck %1 ms behind — flushed it, checking once more."
msgstr "Yhden kaiuttimen reitti oli jumissa %1 ms jäljessä — se tyhjennettiin, tarkistetaan vielä kerran."

#: package/contents/ui/SyncEngine.qml:1379
msgid "The check compares speakers, and too many are muted to compare. Unmute them and check again."
msgstr "Tarkistus vertaa kaiuttimia, ja liian moni on mykistetty vertailua varten. Poista mykistys ja tarkista uudelleen."

#: package/contents/ui/SyncEngine.qml:1385
msgid "This speaker does not carry the inaudible test tone, so the check needed the audible one — and the room was too noisy for it. Pause other audio and try again."
msgstr "Tämä kaiutin ei toista kuulumatonta testiääntä, joten tarkistus tarvitsi kuuluvan — ja huone oli siihen liian meluisa. Keskeytä muu ääni ja yritä uudelleen."

#: package/contents/ui/SyncEngine.qml:1403
msgid "Sync check skipped"
msgstr "Synkkatarkistus ohitettiin"

#: package/contents/ui/SyncEngine.qml:1404
msgid "The speakers here do not carry the inaudible tone to the microphone. Move the microphone closer, or turn off \"Measure with a tone too high to hear\" to use the audible clicks."
msgstr "Nämä kaiuttimet eivät kanna kuulumatonta ääntä mikrofonille asti. Siirrä mikrofoni lähemmäs tai poista käytöstä ”Mittaa äänellä, jota ei kuule”, niin käytetään kuuluvia napsautuksia."

#: package/contents/ui/SyncEngine.qml:1406
msgid "Auto-check: cannot measure without a sound you would hear"
msgstr "Automaattitarkistus: ei voi mitata ilman kuuluvaa ääntä"

#: package/contents/ui/SyncEngine.qml:1426
msgid "The reading from %1 would not settle, so nothing was changed. Trying again usually does it."
msgstr "Kaiuttimen %1 lukema ei asettunut, joten mitään ei muutettu. Uusi yritys yleensä riittää."

#: package/contents/ui/SyncEngine.qml:1472
msgid "%1 stayed silent through both rounds — it was left out of the group. Tick it back in the speaker list any time."
msgstr "%1 pysyi hiljaa molemmilla kierroksilla — se jätettiin pois ryhmästä. Voit valita sen takaisin kaiutinluettelosta milloin tahansa."

#: package/contents/ui/SyncEngine.qml:1477
msgid "%1 made no sound the microphone could hear. If it stays silent on the next calibration too, it will be left out of the group."
msgstr "%1 ei tuottanut ääntä, jonka mikrofoni olisi kuullut. Jos se pysyy hiljaa myös seuraavassa kalibroinnissa, se jätetään pois ryhmästä."

#: package/contents/ui/SyncEngine.qml:1484
msgid "Could not hear %1 during the check — the speaker may be muted or off. The calibration was kept."
msgstr "Kaiutinta %1 ei kuulunut tarkistuksen aikana — se voi olla mykistetty tai pois päältä. Kalibrointi säilytettiin."

#: package/contents/ui/SyncEngine.qml:1492
msgid "Sync verified"
msgstr "Synkronointi varmistettu"

#: package/contents/ui/SyncEngine.qml:1493
msgid "Every speaker arrives within %1 ms at the microphone — in step to the ear."
msgstr "Jokaisen kaiuttimen ääni saapuu mikrofoniin %1 ms sisällä — korvalle samassa tahdissa."

#: package/contents/ui/SyncEngine.qml:1497
msgid "The speakers still arrive %1 ms apart. Calibrate once more, or nudge the delay slider."
msgstr "Kaiuttimien välillä on yhä %1 ms ero. Kalibroi vielä kerran tai hienosäädä viiveliukusäädintä."

#: package/contents/ui/SyncEngine.qml:1539
msgid "Auto-check %1: skipped, something else was using the speakers"
msgstr "Automaattitarkistus %1: ohitettiin, kaiuttimet olivat muussa käytössä"

#: package/contents/ui/SyncEngine.qml:1565
#: package/contents/ui/SyncEngine.qml:1661
msgid "Auto-check %1: settling after the adjustment"
msgstr "Automaattitarkistus %1: asettuu säädön jälkeen"

#: package/contents/ui/SyncEngine.qml:1592
msgid "Auto-check %1: reading would not settle — the microphone may be too far from the speakers"
msgstr "Automaattitarkistus %1: lukema ei asettunut — mikrofoni voi olla liian kaukana kaiuttimista"

#: package/contents/ui/SyncEngine.qml:1598
msgid "Auto-check %1: too quiet to tell"
msgstr "Automaattitarkistus %1: liian hiljaista arvioitavaksi"

#: package/contents/ui/SyncEngine.qml:1713
msgid "Auto-check %1: in sync — measured %2 ms"
msgstr "Automaattitarkistus %1: synkassa — mitattu %2 ms"

#: package/contents/ui/SyncEngine.qml:1714
msgid "Auto-check %1: in sync"
msgstr "Automaattitarkistus %1: synkronissa"

#: package/contents/ui/SyncEngine.qml:1724
msgid "Auto-check %1: %2 ms apart — measured %3 ms"
msgstr "Automaattitarkistus %1: %2 ms erillään — mitattu %3 ms"

#: package/contents/ui/SyncEngine.qml:1725
msgid "Auto-check %1: still %2 ms apart (0 = in step)"
msgstr "Automaattitarkistus %1: yhä %2 ms erossa (0 = tahdissa)"

#: package/contents/ui/SyncEngine.qml:1762
msgid "Sync has drifted"
msgstr "Synkronointi on lipsunut"

#: package/contents/ui/SyncEngine.qml:1763
msgid "The speakers are audibly apart again — run Calibrate when convenient."
msgstr "Kaiuttimet ovat taas kuultavasti eri tahdissa — suorita kalibrointi sopivalla hetkellä."

#: package/contents/ui/SyncEngine.qml:1872
msgid "Speaker timing drifted"
msgstr "Kaiuttimien ajoitus lipsui"

#: package/contents/ui/SyncEngine.qml:1873
msgid "A Bluetooth speaker came back noticeably off its calibration — the sync compensated automatically. Recalibrate when convenient for exact ears."
msgstr "Bluetooth-kaiutin palasi selvästi kalibroinnistaan poikenneena — synkronointi kompensoi eron automaattisesti. Kalibroi uudelleen sopivalla hetkellä tarkkaa kuuntelua varten."

#: package/contents/ui/SyncEngine.qml:2501
#: package/contents/ui/SyncEngine.qml:2736
msgid "Auto-check: listening…"
msgstr "Automaattinen tarkistus: kuunnellaan…"

#: package/contents/ui/SyncEngine.qml:2707
msgid "Auto-check %1: only one speaker can hear the inaudible tone — nothing to compare"
msgstr "Automaattitarkistus %1: vain yksi kaiutin kuulee kuulumattoman äänen — ei vertailtavaa"

#: package/contents/ui/SyncEngine.qml:2766
msgid "Auto-check %1: no answer came back"
msgstr "Automaattitarkistus %1: vastausta ei tullut"

#: package/contents/ui/SyncEngine.qml:2814
msgid "%1: %2 ms"
msgstr "%1: %2 ms"

#. i18n() is given at runtime and the translation is
#. silently skipped in every language.
#: package/contents/ui/SyncEngine.qml:3382
msgid "Sync measurement"
msgstr "Synkronoinnin mittaus"

#: package/contents/ui/SyncEngine.qml:3383
msgid "A recording is running. The measurement plays test tones and quiets the speakers, so it waits until the recording is done."
msgstr "Tallennus on käynnissä. Mittaus soittaa testiääniä ja hiljentää kaiuttimet, joten se odottaa tallennuksen loppuun."

#: package/contents/ui/SyncEngine.qml:3560
msgid "Measuring with a tone too high to hear — about two minutes in total. The music stays silent until the check finishes."
msgstr "Mitataan äänellä, joka on liian korkea kuultavaksi — yhteensä noin kaksi minuuttia. Musiikki pysyy hiljaa, kunnes tarkistus valmistuu."

#: package/contents/ui/SyncEngine.qml:3561
msgid "Two rounds of clicks with a quiet check between them — about two minutes in total. The music stays silent until the check finishes."
msgstr "Kaksi naksahduskierrosta ja niiden välissä hiljainen tarkistus — yhteensä noin kaksi minuuttia. Musiikki pysyy hiljaa, kunnes tarkistus valmistuu."

#: package/contents/ui/SyncEngine.qml:3563
msgid "Skipped (empty jack): %1."
msgstr "Ohitettiin (tyhjä liitäntä): %1."

#: package/contents/ui/SyncEngine.qml:3564
msgid "Calibration started"
msgstr "Kalibrointi aloitettu"

#: package/contents/ui/SyncEngine.qml:3631
msgid "All local outputs (On Air)"
msgstr "Kaikki paikalliset äänilähdöt (On Air)"

#: package/contents/ui/SyncEngine.qml:4573
msgid "Auto-check: measured %1 ms — takes effect the next time the music pauses"
msgstr "Automaattitarkistus: mitattu %1 ms — tulee voimaan, kun musiikki seuraavan kerran pysähtyy"

#: package/contents/ui/SyncEngine.qml:4574
msgid "Auto-check: adjusted — takes effect the next time the music pauses"
msgstr "Automaattitarkistus: säädettiin — tulee voimaan, kun musiikki seuraavan kerran pysähtyy"

#: package/contents/ui/SyncEngine.qml:4763
msgid "Auto-check %1: confirming the room after the rebuild…"
msgstr "Automaattitarkistus %1: vahvistetaan huonetta uudelleenrakennuksen jälkeen…"

#: package/contents/ui/SyncEngine.qml:4830
msgid "Auto-check %1: in step after the rebuild"
msgstr "Automaattitarkistus %1: synkronissa uudelleenrakennuksen jälkeen"

#: package/contents/ui/SyncEngine.qml:4880
#: package/contents/ui/SyncEngine.qml:4920
msgid "Auto-check %1: adjusted — takes effect the next time the music pauses"
msgstr "Automaattitarkistus %1: säädettiin — tulee voimaan, kun musiikki seuraavan kerran pysähtyy"

#: package/contents/ui/SyncEngine.qml:5499
msgid "%1 did not join the sync"
msgstr "%1 ei liittynyt synkronointiin"

#: package/contents/ui/SyncEngine.qml:5501
msgid "The speaker is connected but could not be pulled into the group — switch the sync off and on to rebuild it."
msgstr "Kaiutin on yhdistetty, mutta sitä ei saatu mukaan ryhmään — kytke synkronointi pois päältä ja takaisin päälle ryhmän rakentamiseksi uudelleen."

#: package/contents/ui/SyncEngine.qml:5502
msgid "The speaker is connected but its audio output never appeared — switch the speaker off and on, then connect it again."
msgstr "Kaiutin on yhdistetty, mutta sen äänilähtöä ei ilmestynyt — kytke kaiutin pois päältä ja takaisin päälle ja yhdistä se sitten uudelleen."

#: package/contents/ui/TimeshiftEngine.qml:472
msgid "The stream could not be relayed — trying it directly"
msgstr "Suoratoistoa ei voitu välittää — yritetään suoraan"

#: package/contents/ui/TimeshiftEngine.qml:518
msgid "Not enough free disk space"
msgstr "Levyllä ei ole tarpeeksi vapaata tilaa"


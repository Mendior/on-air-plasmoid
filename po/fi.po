#: package/contents/ui/config/configAppearance.qml:112
msgid "Look up cover art online (Deezer, iTunes)"
msgstr "Hae kansikuvat verkosta (Deezer, iTunes)"

#: package/contents/ui/config/configAppearance.qml:117

#: package/contents/ui/FullRepresentation.qml:4242
#: package/contents/ui/FullRepresentation.qml:4324
msgid "%1 min"
msgstr "%1 min"

#: package/contents/ui/config/configRecording.qml:58
msgid "A hard safety cap for one recording — protects the disk if you forget to stop."
msgstr "Yhden tallennuksen ehdoton yläraja — suojaa levyä, jos unohdat pysäyttää."

#: package/contents/ui/config/configRecording.qml:70
#: package/contents/ui/FullRepresentation.qml:4211
msgid "Scheduled recordings"
msgstr "Ajastetut tallennukset"

#: package/contents/ui/config/configRecording.qml:75
msgid "Schedules are managed in the widget itself: open the popup and go to the Timers tab. Pick a station, start time, duration and repeat (once / daily / weekly) — the widget records in the background, even while nothing is playing. Schedules fire only while the widget is running — they pause while you are logged out or the computer is off or asleep; missed ones are reported when it returns."
msgstr "Ajastuksia hallitaan itse sovelmassa: avaa ponnahdusikkuna ja siirry Ajastimet-välilehdelle. Valitse asema, aloitusaika, kesto ja toisto (kerran / päivittäin / viikoittain) — sovelma tallentaa taustalla, vaikka mitään ei soisi. Ajastukset laukeavat vain sovelman ollessa käynnissä — ne ovat tauolla, kun olet kirjautunut ulos tai tietokone on sammutettu tai lepotilassa; väliin jääneistä ilmoitetaan, kun sovelma palaa."

#: package/contents/ui/config/configRecording.qml:82
msgid "Recordings are saved to your music folder and are for personal use only — do not redistribute them."
msgstr "Tallenteet tallennetaan musiikkikansioosi ja ne ovat vain henkilökohtaiseen käyttöön — älä levitä niitä eteenpäin."


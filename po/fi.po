msgid "Install the pychromecast library to cast to your devices."
msgstr "Asenna pychromecast-kirjasto, jotta voit lähettää ääntä laitteillesi."

#: package/contents/ui/main.qml:7203
msgid "the device"
msgstr "laite"

#: package/contents/ui/main.qml:7203
msgid "Could not cast to %1"
msgstr "Ei voitu lähettää laitteelle %1"

#: package/contents/ui/main.qml:7204
msgid "The device could not play this station."
msgstr "Laite ei voinut toistaa tätä asemaa."

#: package/contents/ui/main.qml:7250
msgid "Casting"
msgstr "Lähetetään"

#: package/contents/ui/main.qml:7251
msgid "The device did not stop — it may still be playing."
msgstr "Laite ei pysähtynyt — se saattaa yhä toistaa."

#: package/contents/ui/main.qml:7329
msgid "Bluetooth is switched off"
msgstr "Bluetooth on pois päältä"

#: package/contents/ui/main.qml:7330
msgid "The adapter would not turn on — check the system tray's Bluetooth switch or System Settings."
msgstr "Sovitin ei käynnistynyt — tarkista ilmoitusalueen Bluetooth-kytkin tai järjestelmäasetukset."

#: package/contents/ui/main.qml:7349 package/contents/ui/main.qml:7467
msgid "the Bluetooth device"
msgstr "Bluetooth-laite"

#: package/contents/ui/main.qml:7348
msgid "Could not connect to %1"
msgstr "Ei voitu yhdistää laitteeseen %1"

#: package/contents/ui/main.qml:7350
msgid "Make sure the speaker is switched on and in range."
msgstr "Varmista, että kaiutin on päällä ja kantaman sisällä."

#: package/contents/ui/main.qml:7466
msgid "Could not pair with %1"
msgstr "Laiteparia ei voitu muodostaa laitteen %1 kanssa"

#: package/contents/ui/main.qml:7468
msgid "Put the speaker in pairing mode (hold its Bluetooth button) and try again."
msgstr "Aseta kaiutin paritustilaan (pidä sen Bluetooth-painiketta pohjassa) ja yritä uudelleen."

#: package/contents/ui/main.qml:7576

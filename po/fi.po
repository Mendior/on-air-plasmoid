#: package/contents/ui/config/configAppearance.qml:308
msgid "Stations move servers; when playback fails, the station is looked up on radio-browser.info and the address it is reachable at now is saved to your list"
msgstr "Asemat vaihtavat palvelimia; kun toisto epäonnistuu, asema haetaan radio-browser.info-palvelusta ja sen tällä hetkellä toimiva osoite tallennetaan luetteloosi"

#: package/contents/ui/config/configAppearance.qml:313
msgid "Count my listening in the worldwide station catalog"
msgstr "Laske kuunteluni mukaan maailmanlaajuiseen asemaluetteloon"

#: package/contents/ui/config/configAppearance.qml:316
msgid "When a station starts playing, a click is reported to radio-browser.info — the request carries the station id only, no account or personal data is added; popular stations become easier to find for everyone"
msgstr "Kun asema alkaa soida, radio-browser.info-palveluun ilmoitetaan kuuntelukerta — pyyntö sisältää vain aseman tunnisteen, ei tiliä eikä henkilötietoja; suositut asemat on kaikkien helpompi löytää"


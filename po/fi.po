#: package/contents/ui/main.qml:6001 package/contents/ui/main.qml:6070
msgid "No track matched \"%1\" — a show or album title often has no single track to find."
msgstr "Mikään kappale ei vastannut hakua \"%1\" — ohjelman tai albumin nimen takana ei usein ole yhtä kappaletta."

#: package/contents/ui/main.qml:6013
msgid "Found only a different show — skipped"
msgstr "Löytyi vain eri ohjelma — ohitettiin"

#: package/contents/ui/main.qml:6014
msgid "Best match for \"%1\" was \"%2\". Not downloading the wrong one."
msgstr "Paras osuma haulle \"%1\" oli \"%2\". Väärää ei ladata."

#: package/contents/ui/main.qml:6036
msgid "Downloading again without the cover"
msgstr "Ladataan uudelleen ilman kansikuvaa"

#: package/contents/ui/main.qml:6037
msgid "Embedding tags needs the python-mutagen package — install it to get covers in your files."
msgstr "Tunnisteiden upottaminen vaatii python-mutagen-paketin — asenna se saadaksesi kansikuvat tiedostoihisi."

#: package/contents/ui/main.qml:6065
msgid "Track downloaded ✓"
msgstr "Kappale ladattu ✓"

#: package/contents/ui/main.qml:6066

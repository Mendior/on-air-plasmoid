msgid "Add…"
msgstr "Додати…"

#: package/contents/ui/config/configGeneral.qml:1251
msgid "Fetching… %1 / %2"
msgstr "Отримання… %1 / %2"

#: package/contents/ui/config/configGeneral.qml:1252
msgid "Fetch missing logos"
msgstr "Отримати відсутні логотипи"

#: package/contents/ui/config/configGeneral.qml:1261
msgid "Re-fetch all"
msgstr "Отримати всі заново"

#: package/contents/ui/config/configGeneral.qml:1266
msgid "Fetch fresh logos for all stations; existing logos are kept if nothing better is found"
msgstr "Отримати свіжі логотипи для всіх станцій; наявні буде збережено, якщо не знайдеться кращих"

#: package/contents/ui/config/configGeneral.qml:1281

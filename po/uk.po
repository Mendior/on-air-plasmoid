msgstr "%1 припав на той самий час — замість нього грає %2."

#: package/contents/ui/main.qml:3950
msgid "the show"
msgstr "передачі"

#: package/contents/ui/main.qml:3949
msgid "No downloaded episode of %1 was on disk — waking with the chime."
msgstr "Жодного завантаженого епізоду %1 не було на диску — будильник із сигналом."

#: package/contents/ui/main.qml:4005
msgid "The station could not start — playing the built-in tone instead."
msgstr "Станція не змогла запуститися — натомість грає вбудований сигнал."

#: package/contents/ui/main.qml:4707
msgid "%1 devices"
msgstr "%1 пристроїв"

#: package/contents/ui/main.qml:5394
msgid "The Bluetooth speaker"
msgstr "Bluetooth-колонка"

#: package/contents/ui/main.qml:5393
msgid "%1 is connected, but its sound never arrived"
msgstr "%1 підключено, але звук так і не надійшов"

#: package/contents/ui/main.qml:5395
msgid "Turn the speaker off and on again, then reconnect it."
msgstr "Вимкніть і знову ввімкніть колонку, а потім підключіть її ще раз."

#: package/contents/ui/main.qml:5810
msgid "Station seems to be off the air"
msgstr "Схоже, станція не в ефірі"

#: package/contents/ui/main.qml:5811
msgid "%1 is not answering at any address the directory knows. It stays in your list — trying again in the background."
msgstr "%1 не відповідає за жодною адресою, відомою каталогу. Вона лишається у вашому списку — спроби тривають у фоні."

#: package/contents/ui/main.qml:5883
msgid "Playing from a backup address"
msgstr "Відтворення з резервної адреси"

#: package/contents/ui/main.qml:5884
msgid "The station's saved address is not answering — playing the directory's closest match for now. Your saved address was kept."
msgstr "Збережена адреса станції не відповідає — поки що грає найближчий збіг із каталогу. Вашу збережену адресу збережено."

#: package/contents/ui/main.qml:5924
msgid "Station found at a new address"
msgstr "Станцію знайдено за новою адресою"

#: package/contents/ui/main.qml:5925
msgid "%1 moved — the new address was saved to your list."
msgstr "%1 переїхала — нову адресу збережено у вашому списку."

#: package/contents/ui/main.qml:7572
msgid "Scheduled recording started"
msgstr "Запланований запис розпочато"

#: package/contents/ui/main.qml:7613
msgid "Episode downloaded"
msgstr "Епізод завантажено"

#: package/contents/ui/main.qml:7693
msgid "Subscriptions exported"
msgstr "Підписки експортовано"

#: package/contents/ui/main.qml:7695
msgid "Export failed"
msgstr "Не вдалося експортувати"

#: package/contents/ui/main.qml:7696
msgid "Could not write the subscriptions file."
msgstr "Не вдалося записати файл підписок."

#: package/contents/ui/main.qml:7800
msgid "Casting needs pychromecast"
msgstr "Трансляція потребує pychromecast"

#: package/contents/ui/main.qml:7801
msgid "Install the pychromecast library to cast to your devices."
msgstr "Встановіть бібліотеку pychromecast, щоб транслювати на свої пристрої."

#: package/contents/ui/main.qml:7822
msgid "the device"
msgstr "пристрій"

#: package/contents/ui/main.qml:7822
msgid "Could not cast to %1"
msgstr "Не вдалося транслювати на %1"

#: package/contents/ui/main.qml:7823
msgid "The device could not play this station."
msgstr "Пристрій не зміг відтворити цю станцію."

#: package/contents/ui/main.qml:7869
msgid "Casting"
msgstr "Трансляція"

#: package/contents/ui/main.qml:7870
msgid "The device did not stop — it may still be playing."
msgstr "Пристрій не зупинився — можливо, він ще відтворює."

#: package/contents/ui/main.qml:7948
msgid "Bluetooth is switched off"
msgstr "Bluetooth вимкнено"

#: package/contents/ui/main.qml:7949
msgid "The adapter would not turn on — check the system tray's Bluetooth switch or System Settings."
msgstr "Адаптер не ввімкнувся — перевірте перемикач Bluetooth у системному лотку або Системні параметри."

#: package/contents/ui/main.qml:7968 package/contents/ui/main.qml:8086
msgid "the Bluetooth device"
msgstr "пристроєм Bluetooth"

#: package/contents/ui/main.qml:7967
msgid "Could not connect to %1"
msgstr "Не вдалося з'єднатися з %1"

#: package/contents/ui/main.qml:7969
msgid "Make sure the speaker is switched on and in range."
msgstr "Переконайтеся, що динамік увімкнено і він у межах досяжності."

#: package/contents/ui/main.qml:8085
msgid "Could not pair with %1"
msgstr "Не вдалося спарувати з %1"

#: package/contents/ui/main.qml:8087
msgid "Put the speaker in pairing mode (hold its Bluetooth button) and try again."
msgstr "Переведіть колонку в режим спарювання (утримуйте кнопку Bluetooth) і спробуйте ще раз."

#: package/contents/ui/main.qml:8195
msgid "ffmpeg is not installed"
msgstr "ffmpeg не встановлено"

#: package/contents/ui/main.qml:8196
msgid "Install ffmpeg to record radio."
msgstr "Встановіть ffmpeg, щоб записувати радіо."

#: package/contents/ui/main.qml:8201
msgid "curl is not installed"
msgstr "curl не встановлено"

#: package/contents/ui/main.qml:8202
msgid "Install curl to record radio."
msgstr "Встановіть curl, щоб записувати радіо."

#: package/contents/ui/main.qml:8205
msgid "Not enough disk space for this recording"
msgstr "Недостатньо місця на диску для цього запису"

#: package/contents/ui/main.qml:8206
msgid "Free some space in %1 and try again."
msgstr "Звільніть місце в %1 і спробуйте ще раз."

#: package/contents/ui/main.qml:8209
msgid "Recording saved ✓ (%1)"
msgstr "Запис збережено ✓ (%1)"

#: package/contents/ui/main.qml:8213
msgid "Recording interrupted (%1 captured)"
msgstr "Запис перервано (записано %1)"

#: package/contents/ui/main.qml:8215
msgid "%1 — the file is much smaller than expected."
msgstr "%1 — файл значно менший, ніж очікувалося."

#: package/contents/ui/main.qml:8220
msgid "The stream could not be captured."
msgstr "Не вдалося захопити потік."

#: package/contents/ui/main.qml:8303 package/contents/ui/main.qml:8372
msgid "yt-dlp is not installed"
msgstr "yt-dlp не встановлено"

#: package/contents/ui/main.qml:8304 package/contents/ui/main.qml:8373
msgid "Install yt-dlp (and ffmpeg) to download tracks."
msgstr "Встановіть yt-dlp (і ffmpeg), щоб завантажувати композиції."

#: package/contents/ui/main.qml:8323 package/contents/ui/main.qml:8392
msgid "Nothing found to download"
msgstr "Нічого завантажувати не знайдено"

#: package/contents/ui/main.qml:8324 package/contents/ui/main.qml:8393
msgid "No track matched \"%1\" — a show or album title often has no single track to find."
msgstr "Жоден трек не збігся з \"%1\" — за назвою передачі чи альбому часто немає окремого треку."

#: package/contents/ui/main.qml:8336
msgid "Found only a different show — skipped"
msgstr "Знайшлася лише інша передача — пропущено"

#: package/contents/ui/main.qml:8337
msgid "Best match for \"%1\" was \"%2\". Not downloading the wrong one."
msgstr "Найкращий збіг для \"%1\" — \"%2\". Неправильну не завантажуємо."

#: package/contents/ui/main.qml:8359
msgid "Downloading again without the cover"
msgstr "Завантажую знову без обкладинки"

#: package/contents/ui/main.qml:8360
msgid "Embedding tags needs the python-mutagen package — install it to get covers in your files."
msgstr "Для вбудовування теґів потрібен пакунок python-mutagen — встановіть його, щоб мати обкладинки у файлах."

#: package/contents/ui/main.qml:8388
msgid "Track downloaded ✓"
msgstr "Композицію завантажено ✓"

#: package/contents/ui/main.qml:8389
msgid "Saved as \"%1\" — newest first in My Music"
msgstr "Збережено як \"%1\" — найновіше згори в Моїй музиці"

#: package/contents/ui/main.qml:8397
msgid "Download failed"
msgstr "Не вдалося завантажити"

#: package/contents/ui/main.qml:8398
msgid "Unknown error"
msgstr "Невідома помилка"

#: package/contents/ui/main.qml:8872
msgid "Audio output changed"
msgstr "Аудіовихід змінено"

#: package/contents/ui/main.qml:8873
msgid "The chosen output device disappeared — using the system default instead."
msgstr "Вибраний пристрій виводу зник — використовується типовий системний вихід."

#: package/contents/ui/MediaListItem.qml:457
msgid "Click again to confirm removal"
msgstr "Клацніть ще раз, щоб підтвердити вилучення"

#: package/contents/ui/MediaListItem.qml:458
msgid "Remove station from list"
msgstr "Вилучити станцію зі списку"

#: package/contents/ui/MediaListItem.qml:532
msgid "Waiting for track info…"
msgstr "Очікування даних про доріжку…"

#: package/contents/ui/SyncEngine.qml:370
msgid "Could not combine the outputs"
msgstr "Не вдалося об'єднати виходи"

#: package/contents/ui/SyncEngine.qml:371
msgid "pactl refused to create the combined output."
msgstr "pactl відмовився створити об'єднаний вихід."

#: package/contents/ui/SyncEngine.qml:793
msgid "The Bluetooth speaker trails by %1 ms, and every speaker's loudness was matched at the microphone — all set and remembered."
msgstr "Bluetooth-колонка відстає на %1 мс, і гучність усіх колонок вирівняно за мікрофоном — усе налаштовано й запам'ятовано."

#: package/contents/ui/SyncEngine.qml:794
msgid "The Bluetooth speaker trails by %1 ms — the delay is set and remembered for this device."
msgstr "Bluetooth-колонка відстає на %1 мс — затримку встановлено й запам'ятовано для цього пристрою."

#: package/contents/ui/SyncEngine.qml:796
msgid "Balance levels set earlier were replaced by the measured ones."
msgstr "Раніше встановлені рівні балансу замінено виміряними."

#: package/contents/ui/SyncEngine.qml:802
msgid "The speakers were matched to the quietest one and the group's volume was raised by %1% to make up for it."
msgstr "Гучномовці вирівняно за найтихішим, а гучність групи піднято на %1%, щоб це компенсувати."

#: package/contents/ui/SyncEngine.qml:803
msgid "The speakers were matched to the quietest one, so the room is quieter than before — turn the volume up if you want it back."
msgstr "Гучномовці вирівняно за найтихішим, тож у кімнаті тихіше, ніж було — підніміть гучність, якщо хочете повернути."

#: package/contents/ui/SyncEngine.qml:812
msgid "The microphone clipped on %1 — that balance was left unchanged; lower the speaker's volume and calibrate again."
msgstr "Мікрофон перевантажився на %1 — цей баланс залишено без змін; зменште гучність колонки та відкалібруйте знову."

#: package/contents/ui/SyncEngine.qml:825
msgid "Measured with %1 — the default microphone stayed silent."
msgstr "Виміряно мікрофоном %1 — типовий мікрофон мовчав."

#: package/contents/ui/SyncEngine.qml:826
msgid "Speakers calibrated"
msgstr "Колонки відкалібровано"

#: package/contents/ui/SyncEngine.qml:839
#: package/contents/ui/SyncEngine.qml:847
#: package/contents/ui/SyncEngine.qml:908
#: package/contents/ui/SyncEngine.qml:916
#: package/contents/ui/SyncEngine.qml:920
msgid "Calibration did not succeed"
msgstr "Калібрування не вдалося"

#: package/contents/ui/SyncEngine.qml:840
msgid "The inaudible tone did not reach the microphone from these speakers. Move the microphone closer, or turn off \"Measure with a tone too high to hear\" to measure with the audible clicks."
msgstr "Нечутний тон не дійшов від цих колонок до мікрофона. Присуньте мікрофон ближче або вимкніть «Вимірювати тоном, зависоким для слуху», щоб виміряти чутними клацаннями."

#: package/contents/ui/SyncEngine.qml:848
#: package/contents/ui/SyncEngine.qml:1221
msgid "Every microphone delivered pure silence. A mic's own mute button is invisible to the system — check the light on the microphone itself, or set a working microphone as the default."
msgstr "Кожен мікрофон видав чисту тишу. Кнопка вимкнення звуку на самому мікрофоні невидима для системи — перевірте індикатор на мікрофоні або зробіть типовим робочий мікрофон."

#: package/contents/ui/SyncEngine.qml:880
msgid "Calibration"
msgstr "Калібрування"

#: package/contents/ui/SyncEngine.qml:882
msgid "The inaudible reading would not settle at this level — trying once more, louder."
msgstr "Нечутне показання не встановилося на цьому рівні — пробуємо ще раз, гучніше."

#: package/contents/ui/SyncEngine.qml:883
msgid "The clicks were too quiet for this room — trying once more, louder."
msgstr "Клацання були надто тихими для цієї кімнати — ще одна спроба, гучніше."

#: package/contents/ui/SyncEngine.qml:909
msgid "The two speakers timed impossibly far apart, so nothing was changed. A speaker that has just reconnected usually needs a minute to settle — try again shortly."
msgstr "Два динаміки виміряно неможливо далеко один від одного, тому нічого не змінено. Щойно перепідключений динамік зазвичай потребує хвилини, щоб установитися — спробуйте невдовзі ще раз."

#: package/contents/ui/SyncEngine.qml:917
msgid "The reading would not settle even with the speakers turned up — nothing was changed. Trying again usually does it."
msgstr "Показання не встановилося навіть із гучнішими динаміками — нічого не змінено. Зазвичай допомагає повторна спроба."

#: package/contents/ui/SyncEngine.qml:921
msgid "Make sure the microphone is not covered and both speakers can be heard, then try again."
msgstr "Переконайтеся, що мікрофон не закритий і чути обидві колонки, потім спробуйте ще раз."

#: package/contents/ui/SyncEngine.qml:955
#: package/contents/ui/SyncEngine.qml:1003
#: package/contents/ui/SyncEngine.qml:1038
#: package/contents/ui/SyncEngine.qml:1132
#: package/contents/ui/SyncEngine.qml:1165
#: package/contents/ui/SyncEngine.qml:1188
#: package/contents/ui/SyncEngine.qml:1194
#: package/contents/ui/SyncEngine.qml:1220
#: package/contents/ui/SyncEngine.qml:1235
#: package/contents/ui/SyncEngine.qml:1281
#: package/contents/ui/SyncEngine.qml:1286
#: package/contents/ui/SyncEngine.qml:1293
#: package/contents/ui/SyncEngine.qml:1306
msgid "Sync check"
msgstr "Перевірка синхронізації"

#: package/contents/ui/SyncEngine.qml:956
msgid "%1 is muted, so the check skipped it. Unmute it and check again to include it."
msgstr "%1 вимкнено, тому перевірка його пропустила. Увімкніть звук і перевірте ще раз, щоб його врахувати."

#: package/contents/ui/SyncEngine.qml:1004
msgid "The speakers were %1 ms apart — measuring once more to confirm."
msgstr "Динаміки розходилися на %1 мс — вимірюємо ще раз для підтвердження."

#: package/contents/ui/SyncEngine.qml:1039
msgid "Two measurements disagreed about the room, so nothing was changed. If the speakers sound apart, press Calibrate."
msgstr "Два вимірювання не зійшлися щодо кімнати, тому нічого не змінено. Якщо динаміки звучать нарізно, натисніть Калібрувати."

#: package/contents/ui/SyncEngine.qml:1133
msgid "The room still reads %1 ms apart, but the difference sits on the wired speaker's road, which does not drift by itself — nothing was changed. If the speakers sound apart, press Calibrate."
msgstr "Кімната досі показує різницю %1 мс, але вона сидить на шляху дротового динаміка, який сам по собі не дрейфує — нічого не змінено. Якщо динаміки звучать нарізно, натисніть Калібрувати."

#: package/contents/ui/SyncEngine.qml:1137
msgid "The speakers were %1 ms apart — adjusted from the measurement, checking once more."
msgstr "Колонки розходилися на %1 мс — скориговано за виміром, перевіряю ще раз."

#: package/contents/ui/SyncEngine.qml:1155
msgid "A speaker's route was stuck %1 ms behind — flushed it, checking once more."
msgstr "Маршрут однієї колонки застряг на %1 мс — очищено, перевіряю ще раз."

#: package/contents/ui/SyncEngine.qml:1189
msgid "The check compares speakers, and too many are muted to compare. Unmute them and check again."
msgstr "Перевірка порівнює колонки, а надто багато з них вимкнено, щоб порівнювати. Увімкніть звук і перевірте ще раз."

#: package/contents/ui/SyncEngine.qml:1195
msgid "This speaker does not carry the inaudible test tone, so the check needed the audible one — and the room was too noisy for it. Pause other audio and try again."
msgstr "Цей гучномовець не передає нечутний тестовий тон, тож перевірка потребувала чутного — а для цього в кімнаті було надто гамірно. Призупиніть інший звук і спробуйте ще раз."

#: package/contents/ui/SyncEngine.qml:1213
msgid "Sync check skipped"
msgstr "Перевірку синхронізації пропущено"

#: package/contents/ui/SyncEngine.qml:1214
msgid "The speakers here do not carry the inaudible tone to the microphone. Move the microphone closer, or turn off \"Measure with a tone too high to hear\" to use the audible clicks."
msgstr "Ці колонки не доносять нечутний тон до мікрофона. Присуньте мікрофон ближче або вимкніть «Вимірювати тоном, зависоким для слуху», щоб використати чутні клацання."

#: package/contents/ui/SyncEngine.qml:1216
msgid "Auto-check: cannot measure without a sound you would hear"
msgstr "Автоперевірка: без чутного звуку виміряти неможливо"

#: package/contents/ui/SyncEngine.qml:1236
msgid "The reading from %1 would not settle, so nothing was changed. Trying again usually does it."
msgstr "Показання з %1 не встановилося, тому нічого не змінено. Зазвичай допомагає повторна спроба."

#: package/contents/ui/SyncEngine.qml:1282
msgid "%1 stayed silent through both rounds — it was left out of the group. Tick it back in the speaker list any time."
msgstr "%1 мовчав в обох раундах — його виключено з групи. Позначте його у списку динаміків будь-коли."

#: package/contents/ui/SyncEngine.qml:1287
msgid "%1 made no sound the microphone could hear. If it stays silent on the next calibration too, it will be left out of the group."
msgstr "%1 не видав жодного звуку, який міг би почути мікрофон. Якщо він мовчатиме й під час наступного калібрування, його буде виключено з групи."

#: package/contents/ui/SyncEngine.qml:1294
msgid "Could not hear %1 during the check — the speaker may be muted or off. The calibration was kept."
msgstr "Під час перевірки %1 не було чути — колонка може бути вимкнена або приглушена. Калібрування збережено."

#: package/contents/ui/SyncEngine.qml:1302
msgid "Sync verified"
msgstr "Синхронізацію підтверджено"

#: package/contents/ui/SyncEngine.qml:1303
msgid "Every speaker arrives within %1 ms at the microphone — in step to the ear."
msgstr "Кожна колонка досягає мікрофона в межах %1 мс — для вуха в одному такті."

#: package/contents/ui/SyncEngine.qml:1307
msgid "The speakers still arrive %1 ms apart. Calibrate once more, or nudge the delay slider."
msgstr "Колонки все ще розходяться на %1 мс. Відкалібруйте ще раз або підправте повзунок затримки."

#: package/contents/ui/SyncEngine.qml:1344
msgid "Auto-check %1: skipped, something else was using the speakers"
msgstr "Автоперевірка %1: пропущено, колонки були зайняті"

#: package/contents/ui/SyncEngine.qml:1369
#: package/contents/ui/SyncEngine.qml:1423
msgid "Auto-check %1: settling after the adjustment"
msgstr "Автоматична перевірка %1: стабілізується після коригування"

#: package/contents/ui/SyncEngine.qml:1396
msgid "Auto-check %1: reading would not settle — the microphone may be too far from the speakers"
msgstr "Автоперевірка %1: показник не стабілізувався — мікрофон може бути надто далеко від колонок"

#: package/contents/ui/SyncEngine.qml:1400
msgid "Auto-check %1: too quiet to tell"
msgstr "Автоперевірка %1: занадто тихо, щоб сказати"

#: package/contents/ui/SyncEngine.qml:1474
msgid "Auto-check %1: in sync — measured %2 ms"
msgstr "Автоматична перевірка %1: синхронно — виміряно %2 мс"

#: package/contents/ui/SyncEngine.qml:1475
msgid "Auto-check %1: in sync"
msgstr "Автоперевірка %1: синхронно"

#: package/contents/ui/SyncEngine.qml:1485
msgid "Auto-check %1: %2 ms apart — measured %3 ms"
msgstr "Автоматична перевірка %1: різниця %2 мс — виміряно %3 мс"

#: package/contents/ui/SyncEngine.qml:1486
msgid "Auto-check %1: still %2 ms apart (0 = in step)"
msgstr "Автоперевірка %1: ще %2 мс різниці (0 = синхронно)"

#: package/contents/ui/SyncEngine.qml:1523
msgid "Sync has drifted"
msgstr "Синхронізація змістилася"

#: package/contents/ui/SyncEngine.qml:1524
msgid "The speakers are audibly apart again — run Calibrate when convenient."
msgstr "Колонки знову помітно розійшлися — запустіть калібрування, коли буде зручно."

#: package/contents/ui/SyncEngine.qml:1633
msgid "Speaker timing drifted"
msgstr "Часування колонки змістилося"

#: package/contents/ui/SyncEngine.qml:1634
msgid "A Bluetooth speaker came back noticeably off its calibration — the sync compensated automatically. Recalibrate when convenient for exact ears."
msgstr "Bluetooth-колонка повернулася помітно поза своїм калібруванням — синхронізація компенсувала автоматично. Відкалібруйте знову, коли буде зручно, для точного звуку."

#: package/contents/ui/SyncEngine.qml:2232
#: package/contents/ui/SyncEngine.qml:2331
msgid "Auto-check: listening…"
msgstr "Автоперевірка: слухаю…"

#: package/contents/ui/SyncEngine.qml:2302
msgid "Auto-check %1: only one speaker can hear the inaudible tone — nothing to compare"
msgstr "Автоперевірка %1: нечутний тон чує лише одна колонка — нема з чим порівнювати"

#: package/contents/ui/SyncEngine.qml:2349
msgid "Auto-check %1: no answer came back"
msgstr "Автоперевірка %1: відповіді не надійшло"

#: package/contents/ui/SyncEngine.qml:2391
msgid "%1: %2 ms"
msgstr "%1: %2 ms"

#. i18n() is given at runtime and the translation is
#. silently skipped in every language.
#: package/contents/ui/SyncEngine.qml:2872
msgid "Sync measurement"
msgstr "Вимірювання синхронізації"

#: package/contents/ui/SyncEngine.qml:2873
msgid "A recording is running. The measurement plays test tones and quiets the speakers, so it waits until the recording is done."
msgstr "Триває запис. Вимірювання відтворює тестові звуки й прибирає гучність, тож воно чекає на завершення запису."

#: package/contents/ui/SyncEngine.qml:3050
msgid "Measuring with a tone too high to hear — about two minutes in total. The music stays silent until the check finishes."
msgstr "Вимірювання тоном, зависоким для слуху — загалом близько двох хвилин. Музика мовчить, доки перевірка не завершиться."

#: package/contents/ui/SyncEngine.qml:3051
msgid "Two rounds of clicks with a quiet check between them — about two minutes in total. The music stays silent until the check finishes."
msgstr "Два раунди клацань із тихою перевіркою між ними — загалом близько двох хвилин. Музика мовчить, доки перевірка не завершиться."

#: package/contents/ui/SyncEngine.qml:3053
msgid "Skipped (empty jack): %1."
msgstr "Пропущено (порожнє гніздо): %1."

#: package/contents/ui/SyncEngine.qml:3054
msgid "Calibration started"
msgstr "Калібрування розпочато"

#: package/contents/ui/SyncEngine.qml:3121
msgid "All local outputs (On Air)"
msgstr "Усі локальні виходи (On Air)"

#: package/contents/ui/SyncEngine.qml:3916
msgid "Auto-check: measured %1 ms — takes effect the next time the music pauses"
msgstr "Автоматична перевірка: виміряно %1 мс — набуде чинності при наступній паузі музики"

#: package/contents/ui/SyncEngine.qml:3917
msgid "Auto-check: adjusted — takes effect the next time the music pauses"
msgstr "Автоматична перевірка: скориговано — набуде чинності при наступній паузі музики"

#: package/contents/ui/SyncEngine.qml:4426
msgid "%1 did not join the sync"
msgstr "%1 не приєднався до синхронізації"

#: package/contents/ui/SyncEngine.qml:4428
msgid "The speaker is connected but could not be pulled into the group — switch the sync off and on to rebuild it."
msgstr "Колонка під'єднана, але її не вдалося додати до групи — вимкніть і знову ввімкніть синхронізацію."

#: package/contents/ui/SyncEngine.qml:4429
msgid "The speaker is connected but its audio output never appeared — switch the speaker off and on, then connect it again."
msgstr "Колонка під'єднана, але її аудіовихід так і не з'явився — вимкніть і ввімкніть колонку, а потім під'єднайте її знову."

#: package/contents/ui/TimeshiftEngine.qml:387
msgid "Not enough free disk space"
msgstr "Недостатньо вільного місця на диску"

